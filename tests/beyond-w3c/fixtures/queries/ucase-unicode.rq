PREFIX foaf: <http://xmlns.com/foaf/0.1/>

# UCASE / LCASE Unicode-correctness probe (#250, fixed 2026-07-06).
#
# SPARQL UCASE/LCASE now map non-ASCII letters correctly (German ü,
# Greek, Cyrillic, etc.) via `uucp`-backed
# string_uppercase_unicode/string_lowercase_unicode (see
# minimal_regrettable_glue_code_each_with_an_open_issue/
# 250_unicode_case_mapping.sh). This query now returns
# "EVE MÜLLER" / "eve müller" for Eve Müller, the spec-correct result
# — was "EVE MüLLER" / "eve müller" (upper case only ASCII-cased the
# non-ü letters) before the fix.
#
# Note: this dataset only exercises ü; the harder cases (German ß
# expanding to "SS", Greek sigma's non-context-sensitive lowercasing)
# are pinned in tests/unit/ucase_lcase_unicode.ml instead.

SELECT ?name ?upper ?lower
WHERE {
  ?p foaf:name ?name .
  BIND (UCASE(STR(?name)) AS ?upper)
  BIND (LCASE(STR(?name)) AS ?lower)
}
ORDER BY ?name
