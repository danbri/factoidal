PREFIX foaf: <http://xmlns.com/foaf/0.1/>

# UCASE / LCASE Unicode-correctness probe (#250).
#
# Currently expected_to_fail: SPARQL UCASE/LCASE in factoidal map only
# ASCII A-Z. Non-ASCII letters (German ü, Greek, Cyrillic, dotted/dotless
# Turkish i) pass through unchanged, so this query returns
# "Eve MüLLER" / "MüLLER" / etc instead of the spec-correct
# "EVE MÜLLER" / "MÜLLER".
#
# When fix #250 lands (Uucp-backed FStar_String.{upper,lower}case),
# the manifest's expected_to_fail marker should be removed and the
# expected upper-cased rows should match exactly.

SELECT ?name ?upper ?lower
WHERE {
  ?p foaf:name ?name .
  BIND (UCASE(STR(?name)) AS ?upper)
  BIND (LCASE(STR(?name)) AS ?lower)
}
ORDER BY ?name
