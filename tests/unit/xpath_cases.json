{
  "provenance": "extracted verbatim from tests/unit/xpath_tests.ml (the F* XPath 1.0 Stage-1 regression battery, 100 cases, F* score 100 pass 0 fail), which is itself spec-cited against XPath 1.0 REC-xpath-19991116. Case #9 (\"desugaring\") restates the original two-evaluation string comparison as a single boolean-equality expression over the same two counts; every other case is a direct str()/boolean()/parse_fails call lifted from the .ml with its fixture, expression and expected value unchanged.",
  "fixtures": {
    "a": "<root a=\"1\" b=\"two\"><child id=\"c1\">first</child><child id=\"c2\">second</child><child id=\"c3\"><!--note-->third</child><ns:tagged>nsval</ns:tagged></root>",
    "b": "<a><b><c><d>leaf</d></c></b></a>",
    "c": "<nums><n v=\"3\"/><n v=\"7\"/><n v=\"10\"/></nums>",
    "d": "<doc><?pi-target pi data?><a>x</a><?other more?></doc>",
    "ns": "<root xmlns=\"http://default.example/\" xmlns:b=\"http://b.example/\" xmlns:a=\"http://a.example/\"><child/></root>"
  },
  "cases": [
    {"name": "§2.2 child axis count", "fixture": "a", "expr": "count(/root/child)", "kind": "string", "expected": "3"},
    {"name": "§2.2 attribute value via '='", "fixture": "a", "expr": "string(/root/@a)", "kind": "string", "expected": "1"},
    {"name": "§2.3 child::* matches every element, any prefix", "fixture": "a", "expr": "count(/root/*)", "kind": "string", "expected": "4"},
    {"name": "§2.3 attribute::* count", "fixture": "a", "expr": "count(/root/@*)", "kind": "string", "expected": "2"},
    {"name": "§2.3 prefix wildcard 'ns:*'", "fixture": "a", "expr": "count(/root/ns:*)", "kind": "string", "expected": "1"},
    {"name": "§2.3 full axis syntax child::child", "fixture": "a", "expr": "count(/root/child::child)", "kind": "string", "expected": "3"},
    {"name": "§2.3 self axis via full syntax", "fixture": "a", "expr": "name(/root/child[1]/self::child)", "kind": "string", "expected": "child"},
    {"name": "§2.3 attribute axis via full syntax", "fixture": "a", "expr": "string(/root/attribute::a)", "kind": "string", "expected": "1"},
    {"name": "§2.5 '//' abbreviation matches explicit desugaring", "fixture": "a", "expr": "count(//child) = count(/descendant-or-self::node()/child)", "kind": "bool", "expected": "true"},
    {"name": "§2.5 '//child' count", "fixture": "a", "expr": "count(//child)", "kind": "string", "expected": "3"},
    {"name": "§2.3 text() node test", "fixture": "a", "expr": "string(/root/child[1]/text())", "kind": "string", "expected": "first"},
    {"name": "§2.3 comment() node test (non-empty)", "fixture": "a", "expr": "boolean(/root/child[3]/comment())", "kind": "bool", "expected": "true"},
    {"name": "§2.3 node() matches text+comment siblings", "fixture": "a", "expr": "count(/root/child[3]/node())", "kind": "string", "expected": "2"},
    {"name": "§2.4 position()=2 predicate", "fixture": "a", "expr": "string(/root/child[position()=2]/@id)", "kind": "string", "expected": "c2"},
    {"name": "§2.4 [2] numeric-predicate shorthand", "fixture": "a", "expr": "string(/root/child[2]/@id)", "kind": "string", "expected": "c2"},
    {"name": "§2.4 last() predicate", "fixture": "a", "expr": "string(/root/child[last()]/@id)", "kind": "string", "expected": "c3"},
    {"name": "§2.4 count() built-in", "fixture": "a", "expr": "count(/root/child)", "kind": "string", "expected": "3"},
    {"name": "§2.3 ancestor axis nearest-first [1]", "fixture": "b", "expr": "name(/a/b/c/d/ancestor::*[1])", "kind": "string", "expected": "c"},
    {"name": "§2.3 ancestor axis nearest-first [2]", "fixture": "b", "expr": "name(/a/b/c/d/ancestor::*[2])", "kind": "string", "expected": "b"},
    {"name": "§2.3 ancestor axis nearest-first [3]", "fixture": "b", "expr": "name(/a/b/c/d/ancestor::*[3])", "kind": "string", "expected": "a"},
    {"name": "§2.3 ancestor axis count", "fixture": "b", "expr": "count(/a/b/c/d/ancestor::*)", "kind": "string", "expected": "3"},
    {"name": "§2.3 ancestor-or-self axis count", "fixture": "b", "expr": "count(/a/b/c/d/ancestor-or-self::*)", "kind": "string", "expected": "4"},
    {"name": "§2.3 parent axis", "fixture": "b", "expr": "name(/a/b/c/d/parent::*)", "kind": "string", "expected": "c"},
    {"name": "§2.3 descendant axis depth", "fixture": "b", "expr": "count(/a/descendant::*)", "kind": "string", "expected": "3"},
    {"name": "§2.3 descendant-or-self axis depth", "fixture": "b", "expr": "count(/a/descendant-or-self::*)", "kind": "string", "expected": "4"},
    {"name": "§2.3 '.' self abbreviation in a predicate", "fixture": "a", "expr": "string(/root/child[.=\"second\"]/@id)", "kind": "string", "expected": "c2"},
    {"name": "§2.3 '..' parent abbreviation", "fixture": "a", "expr": "string(/root/child[1]/../@a)", "kind": "string", "expected": "1"},
    {"name": "§2.6 union of disjoint node-sets", "fixture": "b", "expr": "count(/a/b | /a/b/c)", "kind": "string", "expected": "2"},
    {"name": "§3.4 node-set = string", "fixture": "a", "expr": "/root/@a = \"1\"", "kind": "bool", "expected": "true"},
    {"name": "§3.4 number = node-set comparison", "fixture": "a", "expr": "/root/@a = 1", "kind": "bool", "expected": "true"},
    {"name": "§3.4 node-set != number", "fixture": "a", "expr": "/root/@a != 2", "kind": "bool", "expected": "true"},
    {"name": "§3.4 boolean(node-set) on empty set", "fixture": "a", "expr": "boolean(/root/nonexistent)", "kind": "bool", "expected": "false"},
    {"name": "§3.4 boolean(node-set) on non-empty set", "fixture": "a", "expr": "boolean(/root/child)", "kind": "bool", "expected": "true"},
    {"name": "§3.4 relational op coerces node-set to number", "fixture": "c", "expr": "count(/nums/n[@v > 5])", "kind": "string", "expected": "2"},
    {"name": "§4.4 sum() + string(number) integer formatting (no trailing .0)", "fixture": "c", "expr": "string(sum(/nums/n/@v))", "kind": "string", "expected": "20"},
    {"name": "§4.4 string(number) decimal formatting", "fixture": "a", "expr": "string(3.5)", "kind": "string", "expected": "3.5"},
    {"name": "§4.4 string(number) integer formatting", "fixture": "a", "expr": "string(4)", "kind": "string", "expected": "4"},
    {"name": "§3.4 'div' produces a decimal", "fixture": "a", "expr": "string(7 div 2)", "kind": "string", "expected": "3.5"},
    {"name": "§3.4 'mod'", "fixture": "a", "expr": "string(7 mod 3)", "kind": "string", "expected": "1"},
    {"name": "§3.4 unary minus", "fixture": "a", "expr": "string(-5)", "kind": "string", "expected": "-5"},
    {"name": "§3.4 unary minus binds looser than union (per UnaryExpr ::= '-' UnaryExpr | UnionExpr)", "fixture": "a", "expr": "string(-(1+1))", "kind": "string", "expected": "-2"},
    {"name": "§4.4 round(2.5) rounds toward +Infinity", "fixture": "a", "expr": "string(round(2.5))", "kind": "string", "expected": "3"},
    {"name": "§4.4 round(-2.5) rounds toward +Infinity (not away from zero)", "fixture": "a", "expr": "string(round(-2.5))", "kind": "string", "expected": "-2"},
    {"name": "§4.4 floor(2.7)", "fixture": "a", "expr": "string(floor(2.7))", "kind": "string", "expected": "2"},
    {"name": "§4.4 ceiling(2.1)", "fixture": "a", "expr": "string(ceiling(2.1))", "kind": "string", "expected": "3"},
    {"name": "§4.3 not()", "fixture": "a", "expr": "string(not(false()))", "kind": "string", "expected": "true"},
    {"name": "§4.3 true() and false()", "fixture": "a", "expr": "string(true() and false())", "kind": "string", "expected": "false"},
    {"name": "§4.2 boolean('') is false", "fixture": "a", "expr": "boolean(\"\")", "kind": "bool", "expected": "false"},
    {"name": "§4.2 boolean(non-empty string) is true", "fixture": "a", "expr": "boolean(\"x\")", "kind": "bool", "expected": "true"},
    {"name": "§4.2 concat() with 3 args", "fixture": "a", "expr": "concat(\"a\",\"b\",\"c\")", "kind": "string", "expected": "abc"},
    {"name": "§4.2 contains()", "fixture": "a", "expr": "contains(\"foobar\",\"oba\")", "kind": "bool", "expected": "true"},
    {"name": "§4.2 starts-with()", "fixture": "a", "expr": "starts-with(\"foobar\",\"foo\")", "kind": "bool", "expected": "true"},
    {"name": "§4.2 substring-before()", "fixture": "a", "expr": "substring-before(\"foo/bar\",\"/\")", "kind": "string", "expected": "foo"},
    {"name": "§4.2 substring-after()", "fixture": "a", "expr": "substring-after(\"foo/bar\",\"/\")", "kind": "string", "expected": "bar"},
    {"name": "§4.2 string-length()", "fixture": "a", "expr": "string(string-length(\"hello\"))", "kind": "string", "expected": "5"},
    {"name": "§4.2 normalize-space()", "fixture": "a", "expr": "normalize-space(\"  a   b  c \")", "kind": "string", "expected": "a b c"},
    {"name": "§4.2 substring(\"12345\",1.5,2.6) = \"234\"", "fixture": "a", "expr": "substring(\"12345\",1.5,2.6)", "kind": "string", "expected": "234"},
    {"name": "§4.2 substring(\"12345\",0,3) = \"12\"", "fixture": "a", "expr": "substring(\"12345\",0,3)", "kind": "string", "expected": "12"},
    {"name": "§4.2 substring(\"12345\", 0 div 0, 3) = \"\" (NaN start)", "fixture": "a", "expr": "substring(\"12345\",0 div 0,3)", "kind": "string", "expected": ""},
    {"name": "§4.2 substring(\"12345\", 1, 0 div 0) = \"\" (NaN length)", "fixture": "a", "expr": "substring(\"12345\",1,0 div 0)", "kind": "string", "expected": ""},
    {"name": "§4.2 substring(\"12345\", -42, 1 div 0) = \"12345\" (+Infinity length)", "fixture": "a", "expr": "substring(\"12345\",-42,1 div 0)", "kind": "string", "expected": "12345"},
    {"name": "§4.2 substring(\"12345\", -1 div 0, 1 div 0) = \"\" (-Inf + Inf = NaN)", "fixture": "a", "expr": "substring(\"12345\",-1 div 0,1 div 0)", "kind": "string", "expected": ""},
    {"name": "§2.3 name() on a prefixed element (opaque QName string)", "fixture": "a", "expr": "name(/root/ns:tagged)", "kind": "string", "expected": "ns:tagged"},
    {"name": "§2.3 local-name() strips the prefix", "fixture": "a", "expr": "local-name(/root/ns:tagged)", "kind": "string", "expected": "tagged"},
    {"name": "§2.3 local-name() with no prefix equals name()", "fixture": "a", "expr": "local-name(/root/child[1])", "kind": "string", "expected": "child"},
    {"name": "§3.7 VariableReference in an arithmetic expression", "fixture": "a", "expr": "$x + 1", "kind": "string", "expected": "6", "vars": {"x": 5}},
    {"name": "§2.2 following-sibling axis count", "fixture": "a", "expr": "count(/root/child[1]/following-sibling::*)", "kind": "string", "expected": "3"},
    {"name": "§2.2 following-sibling::child[1] is c2", "fixture": "a", "expr": "string(/root/child[1]/following-sibling::child[1]/@id)", "kind": "string", "expected": "c2"},
    {"name": "§2.2 preceding-sibling count of the last child", "fixture": "a", "expr": "count(/root/ns:tagged/preceding-sibling::*)", "kind": "string", "expected": "3"},
    {"name": "§2.2 preceding-sibling is a reverse axis (nearest first)", "fixture": "a", "expr": "string(/root/child[3]/preceding-sibling::child[1]/@id)", "kind": "string", "expected": "c2"},
    {"name": "§2.2 following axis excludes descendants, counts later elements", "fixture": "a", "expr": "count(/root/child[1]/following::*)", "kind": "string", "expected": "3"},
    {"name": "§2.2 preceding axis excludes ancestors, counts earlier elements", "fixture": "a", "expr": "count(/root/ns:tagged/preceding::*)", "kind": "string", "expected": "3"},
    {"name": "§2.2 following-sibling of the last child is empty", "fixture": "a", "expr": "count(/root/ns:tagged/following-sibling::*)", "kind": "string", "expected": "0"},
    {"name": "§2.3 processing-instruction() counts both PIs", "fixture": "d", "expr": "count(/doc/processing-instruction())", "kind": "string", "expected": "2"},
    {"name": "§2.3 processing-instruction('target') filters by target", "fixture": "d", "expr": "count(/doc/processing-instruction('pi-target'))", "kind": "string", "expected": "1"},
    {"name": "§5 PI string-value is its data", "fixture": "d", "expr": "string(/doc/processing-instruction('pi-target'))", "kind": "string", "expected": "pi data"},
    {"name": "§2.3 name() of a PI is its target", "fixture": "d", "expr": "name(/doc/processing-instruction()[1])", "kind": "string", "expected": "pi-target"},
    {"name": "§2.3 node() sees PIs + element (2 PIs + 1 element = 3)", "fixture": "d", "expr": "count(/doc/node())", "kind": "string", "expected": "3"},
    {"name": "§2.3 '*' does NOT match PIs (principal node type)", "fixture": "d", "expr": "count(/doc/*)", "kind": "string", "expected": "1"},
    {"name": "§3.3 union of overlapping node-sets removes duplicates", "fixture": "a", "expr": "count(/root/child | /root/child[1])", "kind": "string", "expected": "3"},
    {"name": "§3.3 self-union removes all duplicates", "fixture": "a", "expr": "count(/root/child | /root/child)", "kind": "string", "expected": "3"},
    {"name": "§3.3 union result is in document order, not concatenation order", "fixture": "a", "expr": "name((/root/ns:tagged | /root/child[1])[1])", "kind": "string", "expected": "child"},
    {"name": "§3.4 string < string (lexicographic)", "fixture": "a", "expr": "\"abc\" < \"abd\"", "kind": "bool", "expected": "true"},
    {"name": "§3.4 string > string", "fixture": "a", "expr": "\"b\" > \"a\"", "kind": "bool", "expected": "true"},
    {"name": "§3.4 number < number", "fixture": "a", "expr": "3 < 4", "kind": "bool", "expected": "true"},
    {"name": "§3.4 number >= number (equal)", "fixture": "a", "expr": "3.5 >= 3.5", "kind": "bool", "expected": "true"},
    {"name": "§3.4 node-set = node-set (some equal pair)", "fixture": "a", "expr": "/root/child[1] = /root/child[1]", "kind": "bool", "expected": "true"},
    {"name": "§3.4 node-set != node-set (distinct string values)", "fixture": "a", "expr": "/root/child[1] != /root/child[2]", "kind": "bool", "expected": "true"},
    {"name": "§3.4 relational node-set coercion (>=)", "fixture": "c", "expr": "count(/nums/n[@v >= 7])", "kind": "string", "expected": "2"},
    {"name": "§2.2 namespace:: axis parses (no longer deferred)", "fixture": "a", "expr": "namespace::*", "kind": "parsefails", "expected": "false"},
    {"name": "§2.2 namespace axis: count of in-scope namespace nodes", "fixture": "ns", "expr": "count(/*/namespace::node())", "kind": "string", "expected": "4"},
    {"name": "§2.2 namespace axis: xml prefix is always in scope", "fixture": "ns", "expr": "string(/*/namespace::xml)", "kind": "string", "expected": "http://www.w3.org/XML/1998/namespace"},
    {"name": "§5.4 namespace node string-value is its URI", "fixture": "ns", "expr": "string(/*/namespace::a)", "kind": "string", "expected": "http://a.example/"},
    {"name": "§5.4 namespace node name() is its prefix", "fixture": "ns", "expr": "name(/*/namespace::b)", "kind": "string", "expected": "b"},
    {"name": "our order: default namespace node sorts first (empty name)", "fixture": "ns", "expr": "name(/*/namespace::node()[1])", "kind": "string", "expected": ""},
    {"name": "our order: first prefixed node after default is 'a'", "fixture": "ns", "expr": "name(/*/namespace::node()[2])", "kind": "string", "expected": "a"},
    {"name": "our order: xml sorts last here (after a, b)", "fixture": "ns", "expr": "name(/*/namespace::node()[4])", "kind": "string", "expected": "xml"},
    {"name": "§2.2 namespace axis: child inherits ancestor namespaces", "fixture": "ns", "expr": "count(/*/*/namespace::node())", "kind": "string", "expected": "4"},
    {"name": "§2.2 namespace::* wildcard matches all namespace nodes", "fixture": "ns", "expr": "count(/*/namespace::*)", "kind": "string", "expected": "4"},
    {"name": "'id(\"x\")' (unknown function) does not crash the parser", "fixture": "a", "expr": "id(\"x\")", "kind": "parsefails", "expected": "false"}
  ]
}
