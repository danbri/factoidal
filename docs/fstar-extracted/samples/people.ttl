  foaf:name "Dave Patel"@en ;
  foaf:age 38 ;
  foaf:knows ex:alice .

ex:eve a foaf:Person ;
  foaf:name "Eve Müller"@de ;
  foaf:age 24 ;
  foaf:mbox <mailto:eve@example.org> ;
  foaf:knows ex:carol, ex:frank .

ex:frank a foaf:Person ;
  foaf:name "Frank O'Connor"@en ;
  foaf:age 55 ;
  foaf:knows ex:eve, ex:grace .

ex:grace a foaf:Person ;
  foaf:name "Grace Hopper" ;
