ex:radiohead a mo:MusicGroup ;
  dc:title "Radiohead" ;
  ex:formed 1985 ;
  ex:genre  "alternative rock" ;
  ex:member ex:thom, ex:jonny, ex:colin, ex:ed, ex:phil .

ex:beatles a mo:MusicGroup ;
  dc:title "The Beatles" ;
  ex:formed 1960 ;
  ex:genre  "rock" ;
  ex:member ex:john, ex:paul, ex:george, ex:ringo .

ex:kraftwerk a mo:MusicGroup ;
  dc:title "Kraftwerk" ;
  ex:formed 1970 ;
  ex:genre  "electronic" ;
  ex:member ex:ralf, ex:florian .

ex:thom   a mo:MusicArtist ; dc:title "Thom Yorke" .
ex:jonny  a mo:MusicArtist ; dc:title "Jonny Greenwood" .
ex:colin  a mo:MusicArtist ; dc:title "Colin Greenwood" .
ex:ed     a mo:MusicArtist ; dc:title "Ed O'Brien" .
