ex:john   a mo:MusicArtist ; dc:title "John Lennon" .
ex:paul   a mo:MusicArtist ; dc:title "Paul McCartney" .
ex:george a mo:MusicArtist ; dc:title "George Harrison" .
ex:ringo  a mo:MusicArtist ; dc:title "Ringo Starr" .
ex:ralf   a mo:MusicArtist ; dc:title "Ralf Hütter" .
ex:florian a mo:MusicArtist ; dc:title "Florian Schneider" .

ex:okc  a mo:Album ; dc:title "OK Computer"         ; ex:by ex:radiohead ; ex:year 1997 .
ex:kida a mo:Album ; dc:title "Kid A"                ; ex:by ex:radiohead ; ex:year 2000 .
ex:inra a mo:Album ; dc:title "In Rainbows"          ; ex:by ex:radiohead ; ex:year 2007 .
ex:abr  a mo:Album ; dc:title "Abbey Road"           ; ex:by ex:beatles   ; ex:year 1969 .
ex:sgt  a mo:Album ; dc:title "Sgt. Pepper's Lonely Hearts Club Band" ; ex:by ex:beatles ; ex:year 1967 .
ex:auto a mo:Album ; dc:title "Autobahn"             ; ex:by ex:kraftwerk ; ex:year 1974 .
