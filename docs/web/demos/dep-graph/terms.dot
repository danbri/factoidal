  subgraph cluster_legend {
    label="namespace"; fontcolor="#9aa3b2"; fontsize=10;
    style="rounded,dashed"; color="#3a4252";
    rank=sink;
    "_legend_Parser" [label="Parser", shape=box, fillcolor="#cfe8ff", style=filled, fontsize=10];
    "_legend_RDF" [label="RDF", shape=box, fillcolor="#d4f4dd", style=filled, fontsize=10];
    "_legend_RIF" [label="RIF", shape=box, fillcolor="#ffd1dc", style=filled, fontsize=10];
    "_legend_SHACL" [label="SHACL", shape=box, fillcolor="#fff5b3", style=filled, fontsize=10];
    "_legend_SPARQL" [label="SPARQL", shape=box, fillcolor="#ffe6b3", style=filled, fontsize=10];
    "_legend_SPARQL11" [label="SPARQL11", shape=box, fillcolor="#ffd699", style=filled, fontsize=10];
    "_legend_Tableau" [label="Tableau", shape=box, fillcolor="#f5cba7", style=filled, fontsize=10];
    "_legend_Parser" -> "_legend_RDF" [style=invis];
    "_legend_RDF" -> "_legend_RIF" [style=invis];
    "_legend_RIF" -> "_legend_SHACL" [style=invis];
    "_legend_SHACL" -> "_legend_SPARQL" [style=invis];
    "_legend_SPARQL" -> "_legend_SPARQL11" [style=invis];
    "_legend_SPARQL11" -> "_legend_Tableau" [style=invis];
  }
