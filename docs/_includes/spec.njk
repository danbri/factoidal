<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content="{{ description or title }}">
  <title>{{ title }} — Factoidal</title>
  <style>
    :root {
      --ink: #202124;
      --muted: #5f6368;
      --paper: #fff;
      --panel: #f5f7fa;
      --rule: #c9cdd3;
      --link: #005a9c;
      --link-visited: #5b3698;
      --accent: #174a72;
      --accent-soft: #e8f2f8;
      --note: #fff8dc;
      --code: #f3f4f6;
      --max: 76rem;
    }

    * { box-sizing: border-box; }
    html { max-width: 100%; scroll-behavior: smooth; overflow-x: clip; }
    body {
      width: 100%;
      max-width: 100%;
      margin: 0;
      color: var(--ink);
      background: var(--paper);
      font: 1rem/1.62 Georgia, "Times New Roman", serif;
      overflow-wrap: anywhere;
      overflow-x: clip;
    }
    a { color: var(--link); text-underline-offset: .14em; }
    a:visited { color: var(--link-visited); }
    a:hover { text-decoration-thickness: .13em; }
    a:focus-visible, summary:focus-visible {
      outline: .2rem solid #f2b705;
      outline-offset: .18rem;
    }
    .skip-link {
      position: absolute;
      left: -999rem;
      top: .5rem;
      z-index: 20;
      padding: .6rem .9rem;
      color: #fff;
      background: #111;
      font: 600 .95rem/1.2 system-ui, sans-serif;
    }
    .skip-link:focus { left: .5rem; }

    .masthead {
      border-top: .42rem solid var(--accent);
      border-bottom: 1px solid var(--rule);
      background: var(--panel);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .masthead-inner, .page-grid, .spec-footer {
      width: calc(100% - 2rem);
      max-width: var(--max);
      min-width: 0;
      margin-inline: auto;
    }
    .masthead-inner { padding: 1.2rem 0 1.1rem; }
    .brand-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: .65rem 1rem;
    }
    .brand {
      margin-right: auto;
      color: var(--accent);
      font-size: 1.18rem;
      font-weight: 760;
      letter-spacing: .015em;
      text-decoration: none;
    }
    .brand:visited { color: var(--accent); }
    .status {
      display: inline-block;
      border: 1px solid #7696ad;
      border-radius: .22rem;
      padding: .18rem .5rem;
      color: #173f5d;
      background: var(--accent-soft);
      font-size: .76rem;
      font-weight: 730;
      letter-spacing: .055em;
      text-transform: uppercase;
    }
    .utility-links {
      display: flex;
      flex-wrap: wrap;
      gap: .35rem 1rem;
      margin: .85rem 0 0;
      padding: 0;
      list-style: none;
      font-size: .9rem;
    }
    .publication-note {
      margin: .85rem 0 0;
      color: var(--muted);
      font-size: .88rem;
    }

    .page-grid { min-width: 0; padding: 2.1rem 0 4rem; }
    .toc {
      margin: 0 0 2rem;
      border: 1px solid var(--rule);
      border-radius: .24rem;
      background: var(--panel);
      font: .9rem/1.4 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .toc summary {
      cursor: pointer;
      padding: .75rem .85rem;
      color: var(--accent);
      font-weight: 720;
    }
    .toc ul {
      margin: 0;
      padding: 0 .8rem .85rem 1rem;
      list-style: none;
    }
    .toc li { margin: .28rem 0; }
    .toc li.toc-h3 { margin-left: .8rem; font-size: .93em; }
    .toc a { text-decoration: none; }
    .toc a:hover, .toc a[aria-current="location"] { text-decoration: underline; }

    main { min-width: 0; }
    main > h1:first-child {
      max-width: 25ch;
      margin: 0 0 .45rem;
      color: #111820;
      font: 760 clamp(2rem, 6vw, 3.35rem)/1.08 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      letter-spacing: -.025em;
      overflow-wrap: anywhere;
    }
    h2, h3, h4 {
      color: #182b3a;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.25;
      scroll-margin-top: 1rem;
    }
    h2 {
      margin: 2.65rem 0 .8rem;
      padding-bottom: .28rem;
      border-bottom: 1px solid var(--rule);
      font-size: 1.62rem;
    }
    h3 { margin: 2rem 0 .55rem; font-size: 1.25rem; }
    h4 { margin: 1.5rem 0 .45rem; font-size: 1.05rem; }
    p, li { max-width: 76ch; }
    li + li { margin-top: .28rem; }
    strong { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .heading-anchor {
      position: relative;
      top: -.08em;
      font: 500 .58em/1 system-ui, sans-serif;
    }

    blockquote {
      margin: 1.25rem 0;
      padding: .3rem 1rem;
      border-left: .35rem solid #d8b64c;
      background: var(--note);
    }
    code, pre {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: .9em;
    }
    code {
      padding: .08em .25em;
      border-radius: .2rem;
      background: var(--code);
    }
    pre {
      max-width: 100%;
      margin: 1rem 0;
      padding: 1rem;
      border: 1px solid var(--rule);
      border-radius: .24rem;
      background: var(--code);
      line-height: 1.45;
      overflow: auto;
    }
    pre code { padding: 0; background: transparent; }
    table {
      display: block;
      width: 100%;
      max-width: 100%;
      margin: 1.2rem 0 1.6rem;
      border-collapse: collapse;
      overflow-x: auto;
      font: .9rem/1.42 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    th, td {
      min-width: 8rem;
      padding: .55rem .65rem;
      border: 1px solid var(--rule);
      text-align: left;
      vertical-align: top;
    }
    th { color: #182b3a; background: var(--accent-soft); }
    tbody tr:nth-child(even) { background: var(--panel); }
    hr { border: 0; border-top: 1px solid var(--rule); }

    .spec-footer {
      padding: 1.3rem 0 3rem;
      border-top: 1px solid var(--rule);
      color: var(--muted);
      font: .86rem/1.5 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    @media (min-width: 62rem) {
      .page-grid {
        display: grid;
        grid-template-columns: 15.5rem minmax(0, 1fr);
        gap: 3rem;
        align-items: start;
      }
      .toc {
        position: sticky;
        top: 1rem;
        max-height: calc(100vh - 2rem);
        margin: 0;
        overflow: auto;
      }
      .toc summary { cursor: default; }
    }

    @media (max-width: 40rem) {
      .brand-row time { flex-basis: 100%; }
      .utility-links { gap: .45rem .85rem; }
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --ink: #e5e8eb;
        --muted: #b1b8bf;
        --paper: #11161b;
        --panel: #182027;
        --rule: #46525d;
        --link: #83c8f4;
        --link-visited: #c8a8ef;
        --accent: #8bc9ef;
        --accent-soft: #1d3444;
        --note: #332f1d;
        --code: #1b232a;
      }
      .status { color: #d7efff; border-color: #678da6; }
      main > h1:first-child, h2, h3, h4, th { color: #f1f5f8; }
    }

    @media print {
      :root { --paper: #fff; --ink: #000; --muted: #333; --rule: #777; }
      body { font-size: 10.5pt; }
      .skip-link, .toc, .utility-links { display: none !important; }
      .masthead { border-top-width: .2rem; background: #fff; }
      .page-grid { display: block; width: 100%; padding-top: 1rem; }
      main > h1:first-child { max-width: none; font-size: 26pt; }
      h2, h3 { break-after: avoid; }
      pre, table, blockquote { break-inside: avoid; }
      a { color: #000; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to specification</a>
  <header class="masthead">
    <div class="masthead-inner">
      <div class="brand-row">
        <a class="brand" href="{{ '/' | url }}">Factoidal</a>
        <span class="status">{{ specStatus or "Draft" }}</span>
        {% if specDate %}<time datetime="{{ specDate }}">{{ specDate }}</time>{% endif %}
      </div>
      <ul class="utility-links" aria-label="Document links">
        <li><a href="https://github.com/danbri/factoidal/blob/claude/main/docs/shardborough-storage-spec.md">Source Markdown</a></li>
        <li><a href="https://github.com/danbri/factoidal/issues/636">Tracked design work</a></li>
        <li><a href="https://github.com/danbri/factoidal/issues/new">Report an issue</a></li>
        <li><a href="https://github.com/danbri/factoidal">Repository</a></li>
      </ul>
      <p class="publication-note">Factoidal project specification. This is not a W3C publication.</p>
    </div>
  </header>

  <div class="page-grid">
    <details class="toc" open>
      <summary>Table of contents</summary>
      <nav aria-label="Table of contents"><ul id="spec-toc"></ul></nav>
    </details>
    <main id="main">
      {{ content | safe }}
    </main>
  </div>

  <footer class="spec-footer">
    <p>Shardborough is the Factoidal block-storage and execution project. The Markdown source and cited Lean definitions are maintained in the Factoidal repository.</p>
  </footer>

  <script>
    (() => {
      const tocPanel = document.querySelector(".toc");
      if (matchMedia("(max-width: 61.99rem)").matches) tocPanel.open = false;
      const toc = document.getElementById("spec-toc");
      const headings = [...document.querySelectorAll("main h2[id], main h3[id]")];
      const links = new Map();
      for (const heading of headings) {
        const item = document.createElement("li");
        item.className = heading.tagName === "H3" ? "toc-h3" : "toc-h2";
        const link = document.createElement("a");
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent.replace(/\s*#\s*$/, "");
        item.append(link);
        toc.append(item);
        links.set(heading.id, link);
      }

      if ("IntersectionObserver" in window) {
        const visible = new Set();
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          }
          for (const link of links.values()) link.removeAttribute("aria-current");
          const current = headings.find((heading) => visible.has(heading.id));
          if (current) links.get(current.id)?.setAttribute("aria-current", "location");
        }, { rootMargin: "-10% 0px -75% 0px" });
        for (const heading of headings) observer.observe(heading);
      }
    })();
  </script>
</body>
</html>
