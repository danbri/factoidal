<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — Factoidal</title>
<style>
  /* Mobile-first: base rules target a ~390px phone; the only
     widening is the max-width cap. No rule may cause page-level
     horizontal scroll — wide tables/code scroll inside their own
     box (overflow-x: auto). */
  body { font-family: system-ui, -apple-system, sans-serif; max-width: 820px; margin: 1em auto; padding: 0 1em; line-height: 1.6; color: #333; background: #fff; overflow-wrap: break-word; }
  @media (min-width: 720px) { body { margin: 2em auto; } }
  h1 { border-bottom: 2px solid #2d6a4f; padding-bottom: 0.3em; }
  h2 { margin-top: 1.8em; }
  a { color: #2d6a4f; }
  nav { margin-bottom: 1.5em; font-size: 0.95em; }
  nav a { display: inline-block; padding: 0.5em 0.9em 0.5em 0; }
  table { border-collapse: collapse; width: 100%; margin: 1em 0; display: block; overflow-x: auto; }
  @media (min-width: 720px) { table { display: table; overflow-x: visible; } }
  th, td { border: 1px solid #ddd; padding: 0.4em 0.8em; text-align: left; }
  th { background: #f5f5f5; }
  pre { background: #f8f8f8; padding: 1em; overflow-x: auto; border-radius: 4px; }
  code { background: #f0f0f0; padding: 0.15em 0.3em; border-radius: 3px; font-size: 0.9em; }
  pre code { background: none; padding: 0; }
  footer { margin-top: 3em; border-top: 1px solid #ddd; padding-top: 1em; font-size: 0.9em; color: #666; }
  @media (prefers-color-scheme: dark) {
    body { background: #121417; color: #d6dbe1; }
    a { color: #7fd0a7; }
    h1 { border-bottom-color: #7fd0a7; }
    th { background: #1d2126; }
    th, td { border-color: #333a42; }
    pre { background: #1a1e23; }
    code { background: #22272d; }
    footer { border-top-color: #333a42; color: #98a2ad; }
  }
  ul.post-series li.placeholder { color: #888; }
  ul.post-series li.placeholder::after { content: " (planned)"; font-style: italic; }

  /* Observable cell convention: a fenced ```observable-js block gets
     turned into a live cell rendered in the .observable-cell div the
     runtime script inserts right after it. See README below the
     fenced-block markup on this page, and hub-cells.js. */
  pre:has(> code.language-observable-js) {
    border-left: 3px solid #2d6a4f;
  }
  .observable-cell {
    margin: 0 0 1.4em;
    padding: 0.8em 1em;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #fff;
    min-height: 1.4em;
  }
  .observable-cell::before {
    content: "\21b3 live cell output";
    display: block;
    font-size: 0.75em;
    color: #888;
    margin-bottom: 0.4em;
  }
  .observable-cell.observable-cell-error {
    border-color: #c0392b;
    color: #c0392b;
    white-space: pre-wrap;
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
  }
  .observable-cell { overflow-x: auto; }
  .observable-cell svg { max-width: 100%; height: auto; }

  /* `pretty()` cell-output tables (see hub.njk's module script) --
     reuses the page's own table/th/td rules for the grid itself; this
     adds the scrollable wrapper (both axes -- the existing
     overflow-x pattern plus a max-height/overflow-y cap for long
     results) and the small caption/term styling pretty() needs that
     nothing else on the page provides yet. */
  .pretty-table-wrap {
    max-height: 22em;
    overflow: auto;
    border: 1px solid #ddd;
    border-radius: 4px;
  }
  .pretty-table-wrap table { margin: 0; }
  .pretty-table-wrap thead th { position: sticky; top: 0; }
  .pretty-caption {
    font-size: 0.78em;
    color: #888;
    font-style: italic;
    padding: 0.3em 0.6em 0;
  }
  .pretty-term {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
  }
  .pretty-value {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: 0.95em;
    padding: 0.1em 0.4em;
    background: #f5f5f5;
    border-radius: 3px;
  }
  @media (prefers-color-scheme: dark) {
    .pretty-table-wrap { border-color: #333a42; }
    .pretty-caption { color: #98a2ad; }
    .pretty-value { background: #1d2126; }
  }

  /* Cell chrome: the toolbar (Edit toggle + Run button) sits between
     the code block and the output box. Mobile-first: tap targets are
     >= 44px, laid out in a wrapping flex row so the row never forces
     page-level horizontal scroll on a ~390px phone. */
  .observable-cell-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em;
    margin: 0.5em 0 0.8em;
  }
  .observable-cell-btn {
    box-sizing: border-box;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5em 1.1em;
    font: inherit;
    font-size: 0.85em;
    color: #2d6a4f;
    background: #f8f8f8;
    border: 1px solid #ddd;
    border-radius: 4px;
    cursor: pointer;
    line-height: 1.2;
  }
  .observable-cell-btn:hover { background: #eef6f1; }
  .observable-cell-btn:active { background: #e2efe8; }
  .observable-cell-btn[aria-pressed="true"] {
    background: #2d6a4f;
    color: #fff;
    border-color: #2d6a4f;
  }
  .observable-cell-hint {
    flex-basis: 100%;
    font-size: 0.78em;
    color: #888;
    font-style: italic;
  }
  .observable-cell-editor {
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
    background: #f8f8f8;
    border: 1px solid #ddd;
    border-left: 3px solid #2d6a4f;
    border-radius: 4px;
    padding: 1em;
    line-height: 1.5;
    color: inherit;
    resize: vertical;
    overflow-x: auto;
  }
  .observable-cell-editor:focus {
    outline: 2px solid #2d6a4f;
    outline-offset: -1px;
  }
  /* Same specificity as `.observable-cell-editor { display: block }`
     above, but author-origin `[hidden]` here needs the extra class in
     the selector to win the tie -- a bare UA `[hidden]` rule would
     lose to the author `display: block` declaration regardless of
     specificity, since normal author rules outrank normal
     user-agent rules irrespective of selector weight. */
  .observable-cell-editor[hidden] {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    .observable-cell { background: #1a1e23; border-color: #333a42; }
    .observable-cell.observable-cell-error { border-color: #e07060; color: #e07060; }
    .observable-cell-btn { background: #1a1e23; border-color: #333a42; color: #7fd0a7; }
    .observable-cell-btn:hover { background: #232830; }
    .observable-cell-btn:active { background: #272d36; }
    .observable-cell-btn[aria-pressed="true"] { background: #7fd0a7; color: #10130f; border-color: #7fd0a7; }
    .observable-cell-hint { color: #98a2ad; }
    .observable-cell-editor { background: #1a1e23; border-color: #333a42; border-left-color: #7fd0a7; }
    .observable-cell-editor:focus { outline-color: #7fd0a7; }
  }
</style>
</head>
<body>
<nav>
  <a href="{{ '/' | url }}">Home</a>
  <a href="{{ '/web/hub/' | url }}">Hub</a>
  <a href="{{ '/fstar-extracted/' | url }}">Demos</a>
  <a href="{{ '/test-results/' | url }}">Test Results</a>
  <a href="https://github.com/danbri/factoidal">GitHub</a>
</nav>
{{ content | safe }}
<footer>
Factoidal — verified RDF/SPARQL from F*. Interactive cells on this
page run entirely in your browser via the F*-extracted engine and a
vendored Observable runtime — no server, no CDN.
</footer>

<!--
  Runtime wiring for the ```observable-js cell convention. Loaded as a
  module so import specifiers resolve; all imports are same-origin
  Pages paths (respecting the /factoidal/ pathPrefix via the `url`
  filter), never a CDN. See third_party/observable/README.md and
  docs/web/hub/README.md for the convention this implements.
-->
<script type="module">
import { Runtime } from "{{ '/vendor/observable/runtime.esm.js' | url }}";
import { Inspector } from "{{ '/vendor/observable/inspector.esm.js' | url }}";
import * as Factoidal from "{{ '/npm/foafos/browser.js' | url }}";
import * as d3 from "{{ '/vendor/observable/d3.esm.js' | url }}";
import * as Plot from "{{ '/vendor/observable/plot.esm.js' | url }}";
import * as stdlib from "{{ '/vendor/observable/stdlib.esm.js' | url }}";

const runtime = new Runtime();
const main = runtime.module();

// ---------------------------------------------------------------------
// `fn` — the typed, Dataset-returning cell surface.
//
// `Factoidal` (browser.js) is a raw, single-shot CLI wrapper: strings
// in, SPARQL-JSON out (no Dataset, no Map<string, Term> bindings). The
// typed API most hub posts are written against (`parse()` -> Dataset,
// `query()` -> Bindings[] | boolean | Dataset) lives in
// npm/factoidal/index.js, but that module is Node-only (CommonJS
// `require`, `node:fs`, `node:crypto`) and cannot load in a browser
// `<script type="module">` context. Rather than fork the engine or
// re-mirror a browser build of it (both out of scope — see
// docs/web/hub/README.md), this adapter reshapes `Factoidal`'s raw
// CLI calls into the same external contract, entirely client-side:
// parse() returns a small frozen Dataset-like wrapper over the
// engine's own N-Quads dump; query() sniffs the query form (same
// heuristic as npm/factoidal/lib/api.js's sniffQueryForm) to decide
// whether to return an array of Map<string, Term> (SELECT), a
// boolean (ASK), or another Dataset-like wrapper (CONSTRUCT). See
// docs/web/hub/README.md for the full contract every post's cells are
// written against.
// ---------------------------------------------------------------------

const XSD_STRING = "http://www.w3.org/2001/XMLSchema#string";
const RDF_LANGSTRING = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString";

function parseNQuadsTerm(str, i) {
  while (i < str.length && (str[i] === " " || str[i] === "\t")) i++;
  if (str[i] === "<") {
    const end = str.indexOf(">", i);
    return [{ termType: "NamedNode", value: str.slice(i + 1, end) }, end + 1];
  }
  if (str[i] === "_" && str[i + 1] === ":") {
    let j = i + 2;
    while (j < str.length && !/\s/.test(str[j])) j++;
    return [{ termType: "BlankNode", value: str.slice(i + 2, j) }, j];
  }
  if (str[i] === '"') {
    let j = i + 1;
    let lex = "";
    while (str[j] !== '"') {
      if (str[j] === "\\") { lex += str[j] + str[j + 1]; j += 2; }
      else { lex += str[j]; j++; }
    }
    j++; // closing quote
    lex = lex
      .replace(/\\"/g, '"').replace(/\\n/g, "\n")
      .replace(/\\t/g, "\t").replace(/\\r/g, "\r")
      .replace(/\\\\/g, "\\");
    let datatype = XSD_STRING;
    let language = "";
    if (str[j] === "@") {
      let k = j + 1;
      while (k < str.length && /[a-zA-Z0-9-]/.test(str[k])) k++;
      language = str.slice(j + 1, k);
      datatype = RDF_LANGSTRING;
      j = k;
    } else if (str[j] === "^" && str[j + 1] === "^") {
      const start = j + 3; // skip ^^<
      const end = str.indexOf(">", start);
      datatype = str.slice(start, end);
      j = end + 1;
    }
    return [
      { termType: "Literal", value: lex, language, datatype: { termType: "NamedNode", value: datatype } },
      j,
    ];
  }
  throw new Error("parseNQuads: unrecognized term at offset " + i + " in: " + str);
}

function parseNQuadsLine(line) {
  const terms = [];
  let i = 0;
  while (terms.length < 4) {
    while (i < line.length && (line[i] === " " || line[i] === "\t")) i++;
    if (line[i] === "." && (i + 1 >= line.length || /\s/.test(line[i + 1]))) break;
    const [term, next] = parseNQuadsTerm(line, i);
    terms.push(term);
    i = next;
  }
  const [subject, predicate, object, graph] = terms;
  return { subject, predicate, object, graph: graph || null };
}

// Parse N-Triples/N-Quads text (as produced by Factoidal.toRdf() /
// Factoidal.query({output: 'ntriples'})) into an array of quad-shaped
// objects: {subject, predicate, object, graph}, each term
// {termType, value, [language], [datatype]} — the same shape RDF/JS
// terms expose for the fields these hub posts read.
function parseNQuads(text) {
  return text
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l.length > 0 && !l.startsWith("#"))
    .map(parseNQuadsLine);
}

class FnDataset {
  constructor(nquadsText) {
    this._text = nquadsText;
    this._quads = parseNQuads(nquadsText);
  }
  get size() { return this._quads.length; }
  [Symbol.iterator]() { return this._quads[Symbol.iterator](); }
  toNQuads() { return this._text; }
}

// Same heuristic as npm/factoidal/lib/api.js's sniffQueryForm: blank
// out IRIs/comments first so '#' inside a PREFIX IRI or a keyword
// appearing inside a string literal can't hide/fake the query verb.
function sniffQueryForm(sparql) {
  const cleaned = String(sparql).replace(/<[^>]*>/g, " ").replace(/#[^\n]*/g, " ");
  const m = cleaned.match(/\b(select|ask|construct|describe)\b/i);
  return m ? m[1].toLowerCase() : "select";
}

function srjTermToFn(t) {
  if (t.type === "uri") return { termType: "NamedNode", value: t.value };
  if (t.type === "bnode") return { termType: "BlankNode", value: t.value };
  // 'literal' | 'typed-literal'
  const language = t["xml:lang"] || "";
  const datatype = t.datatype || (language ? RDF_LANGSTRING : XSD_STRING);
  return { termType: "Literal", value: t.value, language, datatype: { termType: "NamedNode", value: datatype } };
}

const fn = {
  /**
   * Parse an RDF document into an FnDataset (mirrors
   * npm/factoidal/index.js's `parse(text, {format}) -> Dataset`).
   */
  async parse(text, options) {
    const opts = options || {};
    const nq = await Factoidal.toRdf(text, { format: opts.format || "turtle", baseIRI: opts.baseIRI });
    return new FnDataset(nq);
  },
  /**
   * Query an FnDataset (mirrors npm/factoidal/index.js's
   * `query(data, sparql, {entail}) -> Bindings[] | boolean | Dataset`).
   */
  async query(dataset, sparql, options) {
    const opts = options || {};
    const entail = opts.entail || "none";
    const form = sniffQueryForm(sparql);
    if (form === "construct" || form === "describe") {
      const nt = await Factoidal.query(dataset.toNQuads(), sparql, {
        dataFormat: "nquads", entail, output: "ntriples",
      });
      return new FnDataset(nt);
    }
    const result = await Factoidal.query(dataset.toNQuads(), sparql, {
      dataFormat: "nquads", entail, output: "json",
    });
    if (form === "ask") return !!result.boolean;
    const rows = (result.results && result.results.bindings) || [];
    return rows.map((row) => {
      const map = new Map();
      for (const [name, term] of Object.entries(row)) map.set(name, srjTermToFn(term));
      return map;
    });
  },
  /**
   * SHACL Core validation (mirrors npm/factoidal/index.js's
   * `shaclValidate(data, shapes, options) -> Promise<{conforms, report}>`).
   * `data`/`shapes` may each be raw RDF text (parsed with `options.format`,
   * default "turtle") or an already-parsed FnDataset. Throws the same
   * "predates the SHACL export" error `Factoidal.shaclValidate` throws
   * if the loaded npm-entry bundle doesn't expose it -- callers that
   * want to degrade gracefully should try/catch this call rather than
   * assume it always resolves.
   */
  async shaclValidate(data, shapes, options) {
    const opts = options || {};
    if (typeof Factoidal.shaclValidate !== "function") {
      throw new Error(
        "shaclValidate: the loaded factoidal-npm-entry bundle predates the SHACL export");
    }
    const toNQuads = async (x) => (
      x && typeof x.toNQuads === "function"
        ? x.toNQuads()
        : Factoidal.toRdf(x, { format: opts.format || "turtle" })
    );
    const dataNq = await toNQuads(data);
    const shapesNq = await toNQuads(shapes);
    const result = await Factoidal.shaclValidate(dataNq, shapesNq);
    return { conforms: result.conforms, report: new FnDataset(result.reportNquads) };
  },
};

// ---------------------------------------------------------------------
// `pretty` -- an opt-in, prettier rendering for cell output. A cell
// that `return`s a raw array/object gets the Inspector's default
// collapsed-JS-tree view; a cell that instead `return`s `pretty(value)`
// gets a shape-dispatched DOM rendering instead:
//
//   (a) array of Map      -- SPARQL bindings rows (Map keys = vars)
//                             -> a table, one column per variable.
//   (b) array of plain {} -- table from the union of keys.
//   (c) Dataset-like       -- (.size + Symbol.iterator yielding quads)
//                             -> a triples/quads table (s/p/o[/g]).
//   (d) plain object       -- a two-column key/value table.
//   (e) scalar/string      -- a small styled value span.
//   (f) anything else      -- returned unchanged; Inspector renders it.
//
// Term values (NamedNode/BlankNode/Literal, wherever they appear inside
// a table cell) are shortened for display -- an IRI compacts to its
// trailing path/fragment segment with the full IRI in a `title`
// tooltip, a literal is quoted (with @lang or ^^datatype suffix, full
// detail in the tooltip), a blank node gets a `_:` prefix. This is a
// browser-only DOM-returning implementation; the Node-side test harness
// (tests/hub/_helpers.mjs) provides a `pretty` stub with the same
// shape-dispatch that returns a plain, DOM-free structure instead, so
// pinned tests can assert on table shape without a browser. See
// docs/web/hub/README.md's cell-bindings table for the contract both
// sides implement.
// ---------------------------------------------------------------------

function prettyShortenIri(iri) {
  const m = /[/#]([^/#]+)$/.exec(iri);
  const tail = m ? m[1] : iri;
  return tail.length > 0 ? tail : iri;
}

// Render one RDF/JS-shaped term ({termType, value, [language],
// [datatype]}) as a compact <span> with the full detail in `title`;
// anything that isn't actually a term-shaped object is rendered as
// plain text so pretty() degrades gracefully on non-RDF data.
function prettyTermNode(term) {
  const span = document.createElement("span");
  span.className = "pretty-term";
  if (term && typeof term === "object" && typeof term.termType === "string") {
    if (term.termType === "NamedNode") {
      span.textContent = prettyShortenIri(term.value);
      span.title = term.value;
    } else if (term.termType === "BlankNode") {
      span.textContent = "_:" + term.value;
      span.title = "_:" + term.value;
    } else if (term.termType === "Literal") {
      let text = JSON.stringify(String(term.value));
      let detail = '"' + term.value + '"';
      if (term.language) {
        text += "@" + term.language;
        detail += "@" + term.language;
      } else if (term.datatype && term.datatype.value && term.datatype.value !== XSD_STRING) {
        text += "^^" + prettyShortenIri(term.datatype.value);
        detail += "^^<" + term.datatype.value + ">";
      }
      span.textContent = text;
      span.title = detail;
    } else {
      span.textContent = String(term.value);
    }
  } else {
    span.textContent = term === undefined || term === null ? "" : String(term);
  }
  return span;
}

function prettyIsPlainObject(v) {
  if (typeof v !== "object" || v === null) return false;
  if (Array.isArray(v)) return false;
  if (v instanceof Map || v instanceof Set) return false;
  const proto = Object.getPrototypeOf(v);
  return proto === Object.prototype || proto === null;
}

function prettyIsDatasetLike(v) {
  return (
    typeof v === "object" && v !== null && !Array.isArray(v) &&
    !(v instanceof Map) && !(v instanceof Set) &&
    typeof v.size === "number" && typeof v[Symbol.iterator] === "function"
  );
}

function prettyCellNode(value) {
  if (value && typeof value === "object" && typeof value.termType === "string") {
    return prettyTermNode(value);
  }
  const span = document.createElement("span");
  span.textContent = value === undefined || value === null ? "" : String(value);
  return span;
}

function prettyCount(n, noun) {
  return n + " " + noun + (n === 1 ? "" : "s");
}

function prettyBuildTable(columns, rows, captionText) {
  const wrap = document.createElement("div");
  wrap.className = "pretty-table-wrap";

  const caption = document.createElement("div");
  caption.className = "pretty-caption";
  caption.textContent = captionText;
  wrap.appendChild(caption);

  const table = document.createElement("table");
  table.className = "pretty-table";

  const thead = document.createElement("thead");
  const headRow = document.createElement("tr");
  for (const col of columns) {
    const th = document.createElement("th");
    th.textContent = col;
    headRow.appendChild(th);
  }
  thead.appendChild(headRow);
  table.appendChild(thead);

  const tbody = document.createElement("tbody");
  for (const row of rows) {
    const tr = document.createElement("tr");
    for (const cell of row) {
      const td = document.createElement("td");
      td.appendChild(prettyCellNode(cell));
      tr.appendChild(td);
    }
    tbody.appendChild(tr);
  }
  table.appendChild(tbody);
  wrap.appendChild(table);
  return wrap;
}

function pretty(value) {
  // (a) array of Map -- SPARQL bindings rows.
  if (Array.isArray(value) && value.length > 0 && value.every((r) => r instanceof Map)) {
    const columns = [];
    for (const row of value) {
      for (const k of row.keys()) if (!columns.includes(k)) columns.push(k);
    }
    const rows = value.map((row) => columns.map((c) => (row.has(c) ? row.get(c) : "")));
    return prettyBuildTable(columns, rows, prettyCount(value.length, "row"));
  }

  // (c) Dataset-like -- checked ahead of the plain-object-array case
  // below since a Dataset is not itself an Array.
  if (prettyIsDatasetLike(value)) {
    const quads = [...value];
    const hasGraph = quads.some((q) => q && q.graph && q.graph.value);
    const columns = hasGraph ? ["s", "p", "o", "g"] : ["s", "p", "o"];
    const rows = quads.map((q) => {
      const row = [q.subject, q.predicate, q.object];
      if (hasGraph) row.push(q.graph || "");
      return row;
    });
    return prettyBuildTable(columns, rows, prettyCount(quads.length, "row"));
  }

  // (b) array of plain objects -- table from the union of keys.
  if (Array.isArray(value) && value.length > 0 && value.every(prettyIsPlainObject)) {
    const columns = [];
    for (const obj of value) {
      for (const k of Object.keys(obj)) if (!columns.includes(k)) columns.push(k);
    }
    const rows = value.map((obj) => columns.map((k) => (k in obj ? obj[k] : "")));
    return prettyBuildTable(columns, rows, prettyCount(value.length, "row"));
  }

  // (d) plain object -- two-column key/value table.
  if (prettyIsPlainObject(value)) {
    const entries = Object.entries(value);
    return prettyBuildTable(["key", "value"], entries, prettyCount(entries.length, "field"));
  }

  // (e) scalars/strings -- a simple styled value span.
  if (
    typeof value === "string" || typeof value === "number" ||
    typeof value === "boolean" || typeof value === "bigint"
  ) {
    const span = document.createElement("span");
    span.className = "pretty-value";
    span.textContent = String(value);
    return span;
  }

  // (f) anything else (null, undefined, DOM nodes, functions, a lone
  // Map, an empty array, ...) -- unchanged, so Inspector's own
  // renderer handles it.
  return value;
}

// Fixed bindings every cell gets access to, by parameter name — this
// is the whole "standard library" a hub post can rely on. Extend this
// list (and the mirrored `new Function(...)` parameter list below)
// deliberately; it's the interface post-authoring (wave B) writes
// against. See docs/web/hub/README.md for the full contract.
const CELL_BINDINGS = ["Factoidal", "fn", "d3", "Plot", "html", "md", "pretty"];
main.variable().define("Factoidal", [], () => Factoidal);
main.variable().define("fn", [], () => fn);
main.variable().define("d3", [], () => d3);
main.variable().define("Plot", [], () => Plot);
main.variable().define("html", [], () => stdlib.html);
main.variable().define("md", [], () => stdlib.md);
main.variable().define("pretty", [], () => pretty);

// Each cell body is an async function body: write a `return` statement
// to produce the value the Inspector renders (or mutate the DOM
// directly via a passed-in element -- Inspector handles DOM-Node
// return values by inserting them as-is). Shared by the initial mount
// and every subsequent Run.
function compileCell(source) {
  return new Function(
    ...CELL_BINDINGS,
    "return (async () => {\n" + source + "\n})();"
  );
}

function mountCell(codeEl, index) {
  const pre = codeEl.closest("pre") || codeEl.parentElement;
  let currentSource = codeEl.textContent;
  let editing = false;

  // --- Editable source: a textarea seeded from the shipped code,
  // swapped in for the static <pre> by the Edit toggle. A textarea
  // (rather than a contenteditable region) is deliberate: iOS Safari's
  // contenteditable caret placement and undo stack are unreliable
  // (cursor jumps on re-render, inconsistent Enter-key node splitting),
  // whereas a plain textarea gets the native mobile keyboard, native
  // undo, and reliable autocorrect/autocapitalize suppression via
  // ordinary attributes -- exactly what code entry on a phone needs.
  const editor = document.createElement("textarea");
  editor.className = "observable-cell-editor";
  editor.spellcheck = false;
  editor.setAttribute("autocapitalize", "off");
  editor.setAttribute("autocorrect", "off");
  editor.setAttribute("autocomplete", "off");
  editor.setAttribute("wrap", "soft");
  editor.setAttribute("aria-label", "Cell source (editable)");
  editor.value = currentSource;
  editor.rows = Math.min(20, Math.max(3, currentSource.split("\n").length));
  editor.hidden = true;

  function autoGrow() {
    editor.style.height = "auto";
    editor.style.height = editor.scrollHeight + "px";
  }
  editor.addEventListener("input", autoGrow);
  editor.addEventListener("keydown", (ev) => {
    // Cmd/Ctrl+Enter: run the current source without leaving the
    // keyboard -- the desktop-friendly counterpart to the mobile Run
    // button.
    if ((ev.metaKey || ev.ctrlKey) && ev.key === "Enter") {
      ev.preventDefault();
      runCell();
    }
  });

  // --- Toolbar: Edit toggle + Run button, between the code and the
  // output box. Tap targets are >= 44px (see .observable-cell-btn);
  // deliberately quiet styling since the page is a blog first.
  const toolbar = document.createElement("div");
  toolbar.className = "observable-cell-toolbar";
  toolbar.title = "Edit the code above and tap Run to re-execute it live in your browser.";

  const editBtn = document.createElement("button");
  editBtn.type = "button";
  editBtn.className = "observable-cell-btn observable-cell-edit-btn";
  editBtn.textContent = "Edit";
  editBtn.setAttribute("aria-pressed", "false");
  editBtn.addEventListener("click", () => setEditing(!editing));

  const runBtn = document.createElement("button");
  runBtn.type = "button";
  runBtn.className = "observable-cell-btn observable-cell-run-btn";
  runBtn.textContent = "Run";
  runBtn.addEventListener("click", runCell);

  toolbar.appendChild(editBtn);
  toolbar.appendChild(runBtn);

  // Discoverability: a phone has no hover, so a title attribute alone
  // (the desktop affordance above) is invisible on mobile -- the owner
  // report this change fixes. Spell it out visibly, once per page, on
  // the first cell only, so the read-flow isn't cluttered on every one.
  if (index === 0) {
    const hint = document.createElement("span");
    hint.className = "observable-cell-hint";
    hint.textContent = "Edit & re-run — computed in your browser.";
    toolbar.appendChild(hint);
  }

  function setEditing(on) {
    editing = on;
    pre.hidden = on;
    editor.hidden = !on;
    editBtn.textContent = on ? "Done" : "Edit";
    editBtn.setAttribute("aria-pressed", on ? "true" : "false");
    if (on) {
      editor.value = currentSource;
      requestAnimationFrame(() => {
        autoGrow();
        editor.focus();
      });
    }
  }

  const container = document.createElement("div");
  container.className = "observable-cell";
  container.setAttribute("data-hub-cell", String(index));

  pre.insertAdjacentElement("afterend", editor);
  editor.insertAdjacentElement("afterend", toolbar);
  toolbar.insertAdjacentElement("afterend", container);

  const name = "hubCell" + index;

  // Wrap the Inspector so a runtime error (thrown during the cell's
  // async body, on the initial run or any subsequent Run) gets the
  // existing .observable-cell-error styling the rest of the page
  // already uses, and so a later successful Run clears it again --
  // Inspector's own state (the observablehq--error class on the same
  // node) is left in place underneath, this just adds the project's
  // own class on top of it.
  const inspector = new Inspector(container);
  const inspectorFulfilled = inspector.fulfilled.bind(inspector);
  const inspectorRejected = inspector.rejected.bind(inspector);
  inspector.fulfilled = (value, varName) => {
    container.classList.remove("observable-cell-error");
    inspectorFulfilled(value, varName);
  };
  inspector.rejected = (error, varName) => {
    container.classList.add("observable-cell-error");
    inspectorRejected(error, varName);
  };

  function runCell() {
    const source = editing ? editor.value : currentSource;
    currentSource = source;
    codeEl.textContent = source; // keep the static view in sync for next Edit/toggle
    let fn;
    try {
      fn = compileCell(source);
    } catch (err) {
      container.classList.add("observable-cell-error");
      container.textContent = "Cell parse error: " + err.message;
      return;
    }
    try {
      // module.redefine(name, inputs, definition): looks up the
      // already-defined variable by name and re-runs variable.define
      // on it, so the SAME Variable (and therefore the SAME attached
      // Inspector/output node) recomputes with the new function body
      // -- this is the supported "edit and re-run" path the vendored
      // runtime exposes (see third_party/observable/dist/runtime.esm.js's
      // module_redefine, which throws if the name was never defined,
      // hence the try/define fallback below for the very first mount).
      main.redefine(name, CELL_BINDINGS, fn);
    } catch (err) {
      container.classList.add("observable-cell-error");
      container.textContent = "Cell define error: " + err.message;
    }
  }

  let fn0;
  try {
    fn0 = compileCell(currentSource);
  } catch (err) {
    container.classList.add("observable-cell-error");
    container.textContent = "Cell parse error: " + err.message;
    return;
  }

  try {
    main.variable(inspector).define(name, CELL_BINDINGS, fn0);
  } catch (err) {
    container.classList.add("observable-cell-error");
    container.textContent = "Cell define error: " + err.message;
  }
}

document
  .querySelectorAll("pre > code.language-observable-js")
  .forEach((codeEl, index) => mountCell(codeEl, index));
</script>
</body>
</html>
