      ? { consistent: parsed.consistent }
      : { consistent: parsed.consistent, reason: parsed.reason };
  },
  /**
   * OWL entailment check (mirrors npm/factoidal/index.js's
   * `owlEntails(premise, conclusion, options) -> {entailed, via,
   * reason?}`): the OWL-RL closure path then negate-and-refute. Each
   * argument may be raw RDF text (parsed with `options.format`, default
   * "turtle") or an FnDataset. `entailed` is true|false|null.
   */
  async owlEntails(premise, conclusion, options) {
    const opts = options || {};
    if (typeof Factoidal.owlEntails !== "function") {
      throw new Error(
        "owlEntails: the loaded factoidal-npm-entry bundle predates the owlEntails export");
    }
    const toNq = async (x) => (x && typeof x.toNQuads === "function"
      ? x.toNQuads()
      : Factoidal.toRdf(x, { format: opts.format || "turtle" }));
    const premiseNq = await toNq(premise);
    const conclusionNq = await toNq(conclusion);
    const optsJson = JSON.stringify(opts.fuel != null ? { fuel: String(opts.fuel) } : {});
    const parsed = await Factoidal.owlEntails(premiseNq, conclusionNq, optsJson);
    return parsed.reason === undefined
      ? { entailed: parsed.entailed, via: parsed.via }
      : { entailed: parsed.entailed, via: parsed.via, reason: parsed.reason };
  },
  /**
   * RDFC-1.0 canonicalization (mirrors npm/factoidal/index.js's
   * `canonicalize(data, options) -> Promise<string>`): canonical
   * blank-node labels plus sorted canonical N-Quads text. `data` may
   * be raw RDF text (parsed with `options.format`, default "turtle")
   * or an already-parsed FnDataset.
   */
  async canonicalize(data, options) {
    const opts = options || {};
    if (data && typeof data.toNQuads === "function") {
      return Factoidal.canonicalize(data.toNQuads(), { format: "nquads" });
    }
    return Factoidal.canonicalize(data, { format: opts.format || "turtle" });
  },
  /**
   * Apply a SPARQL 1.1 Update to an FnDataset, returning the updated
   * FnDataset (mirrors npm/factoidal/index.js's
   * `update(data, updateText) -> Promise<Dataset>`). Needs the
   * npm-entry engine bundle -- reaches for `Factoidal.loadNpmEntry()`'s
   * raw ABI internally so a cell never has to.
   */
  async update(dataset, updateText) {
    const abi = await Factoidal.loadNpmEntry();
    if (typeof abi.updateDataset !== "function") {
      throw new Error(
        "update: the loaded factoidal-npm-entry bundle predates the SPARQL Update export");
    }
    const nq = dataset && typeof dataset.toNQuads === "function"
      ? dataset.toNQuads()
      : await Factoidal.toRdf(dataset, { format: "turtle" });
    const r = JSON.parse(abi.updateDataset(nq, updateText));
    if (!r.ok) throw new Error(r.error || "update failed");
    return new FnDataset(r.nquads);
  },
  /**
   * Feature probe for the npm-entry engine bundle backing this page
   * (mirrors npm/factoidal/lib/api.js's `capabilities()` -- a
   * `typeof entry.X === 'function'` check per feature, not a blanket
   * version check). Never throws: `entry: false` on any failure to
   * load the bundle, same as the Node-side capabilities()'s own
   * try/catch-and-report-false contract.
   */
  async capabilities() {
    const FEATURE_ABI_FN = {
      shacl: "shaclValidate", shex: "shexValidate", owlClosure: "owlClosure",
      coreRdfsClosure: "rhoDfClosure", coreRdfsCheck: "rhoDfFragmentCheck",
      rdfsPlusClosure: "rdfsPlusClosure",
      rhoDfClosure: "rhoDfClosure", rhoDfFragmentCheck: "rhoDfFragmentCheck",
      rml: "rmlMap", csvw: "csvwToRdf", jsonld: "jsonldToRdf", rif: "rifEval",
      xslt: "xsltTransform", mathml: "mathmlEval", xforms: "xformsRecalc",
      jsonSchema: "jsonSchemaValidate", schematron: "schematronValidate",
      toan: "toanSummation", matrix: "matrixDeterminant",
    };
    let abi;
    try {
      abi = await Factoidal.loadNpmEntry();
    } catch (err) {
      return { entry: false };
    }
    const caps = { entry: true };
    for (const [name, fnName] of Object.entries(FEATURE_ABI_FN)) {
      caps[name] = typeof abi[fnName] === "function";
    }
    return caps;
  },
  /**
   * XSLT 1.0 transform (mirrors npm/factoidal/index.js's
   * `xsltTransform(stylesheetXml, sourceXml) -> Promise<string>`).
   */
  async xsltTransform(stylesheetXml, sourceXml) {
    return Factoidal.xsltTransform(stylesheetXml, sourceXml);
  },
  /**
   * Evaluate a Content MathML document (mirrors npm/factoidal/index.js's
   * `mathmlEval(contentMathmlXml, bindings) -> Promise<MathValue>`).
   */
  async mathmlEval(contentMathmlXml, bindings) {
    return Factoidal.mathmlEval(contentMathmlXml, bindings);
  },
  /**
   * XForms recalculate (mirrors npm/factoidal/index.js's
   * `xformsRecalc(instanceXml, binds) -> Promise<{instance, validity}>`).
   */
  async xformsRecalc(instanceXml, binds) {
    return Factoidal.xformsRecalc(instanceXml, binds);
  },
  /**
   * JSON Schema (draft-07) validation (mirrors npm/factoidal/index.js's
   * `jsonSchemaValidate(schemaJson, instanceJson) -> Promise<{valid, result, errors}>`).
   */
  async jsonSchemaValidate(schemaJson, instanceJson) {
    return Factoidal.jsonSchemaValidate(schemaJson, instanceJson);
  },
  /**
   * Schematron validation (mirrors npm/factoidal/index.js's
   * `schematronValidate(schematronXml, instanceXml) -> Promise<{findings}>`).
   */
  async schematronValidate(schematronXml, instanceXml) {
    return Factoidal.schematronValidate(schematronXml, instanceXml);
  },
  /** Finite summation, as Content MathML (mirrors npm/factoidal/index.js's toanSummation). */
  async toanSummation(bodyExpr, idx, lo, hi) {
    return Factoidal.toanSummation(bodyExpr, idx, lo, hi);
  },
  /** Finite product, as Content MathML (mirrors npm/factoidal/index.js's toanProduct). */
  async toanProduct(bodyExpr, idx, lo, hi) {
    return Factoidal.toanProduct(bodyExpr, idx, lo, hi);
  },
  /** Canonical simplification, as Content MathML (mirrors npm/factoidal/index.js's toanSimplify). */
  async toanSimplify(expr) {
    return Factoidal.toanSimplify(expr);
  },
  /** Derivative w.r.t. `variable`, as Content MathML (mirrors npm/factoidal/index.js's toanDiff). */
  async toanDiff(expr, variable) {
    return Factoidal.toanDiff(expr, variable);
  },
  /** `expr[variable := value]` simplified, as Content MathML (mirrors npm/factoidal/index.js's toanSubst). */
  async toanSubst(expr, variable, value) {
    return Factoidal.toanSubst(expr, variable, value);
  },
  /** Exact determinant of a square matrix (mirrors npm/factoidal/index.js's matrixDeterminant). */
  async matrixDeterminant(matrix) {
    return Factoidal.matrixDeterminant(matrix);
  },
  /** Dot product of two vectors (mirrors npm/factoidal/index.js's matrixScalarProduct). */
  async matrixScalarProduct(a, b) {
    return Factoidal.matrixScalarProduct(a, b);
  },
  /** Cross product of two 3-vectors (mirrors npm/factoidal/index.js's matrixVectorProduct). */
  async matrixVectorProduct(a, b) {
    return Factoidal.matrixVectorProduct(a, b);
  },
  /** Outer product of two vectors (mirrors npm/factoidal/index.js's matrixOuterProduct). */
  async matrixOuterProduct(a, b) {
    return Factoidal.matrixOuterProduct(a, b);
  },
  /**
   * Run a SPARQL 1.1 query against a read-only HDT artifact's raw
   * bytes (mirrors npm/factoidal/index.js's
   * `queryHdt(hdtBytes, sparql) -> Promise<Bindings[] | boolean>`).
   * Encapsulates the `Factoidal.runFactoidalCli(['--data-hdt', ...])`
   * shim entirely -- a cell never builds the argv or fake-filesystem
   * entry itself. Default graph only, SELECT/ASK only.
   */
  async queryHdt(hdtBytes, sparql) {
    const result = await Factoidal.queryHdt(hdtBytes, sparql);
    if (typeof result === "boolean") return result;
    if (typeof result.boolean === "boolean") return result.boolean;
    const rows = (result.results && result.results.bindings) || [];
    return rows.map((row) => {
      const map = new Map();
      for (const [name, term] of Object.entries(row)) map.set(name, srjTermToFn(term));
      return map;
    });
  },
  /**
   * Post 37 ("Installed, not vendored"): load the ACTUAL
   * `@factoidal/core` package published to the npm registry, from a
   * CDN that serves npm packages verbatim, and reshape it into the
   * same typed contract `fn` exposes (see makeTypedApiOverRaw above).
   * Tries jsdelivr then unpkg -- both mirror npm's exact file layout
   * for this package (confirmed: browser.js's relative `./factoidal.js`
   * / `./factoidal-npm-entry.js` fetches resolve against either CDN
   * origin). This is the ONE cell binding in the whole hub that loads
   * third-party CODE, not just third-party data -- see hub.njk's CSP
   * comment at the top of this file for the narrow, per-page carve-out
   * that makes the dynamic import() below survive CSP on this post's
   * live twin; on every other page (and on this post's own strict/
   * default page) the import is CSP-blocked and rejects, which the
   * calling cell must catch itself (see the post's prose -- this
   * function deliberately does NOT swallow the error, so the happy
   * path stays assertable in the Node test).
   */
  async loadRegistryPackage(version) {
    const v = version || "0.1.0";
    const urls = [
      `https://cdn.jsdelivr.net/npm/@factoidal/core@${v}/browser.js`,
      `https://unpkg.com/@factoidal/core@${v}/browser.js`,
    ];
    const errors = [];
    for (const url of urls) {
      try {
        const raw = await import(/* @vite-ignore */ url);
        return makeTypedApiOverRaw(raw);
      } catch (e) {
        errors.push(`${url}: ${e && e.message}`);
      }
    }
    throw new Error(
      `loadRegistryPackage: could not load @factoidal/core@${v} from any CDN -- ${errors.join("; ")}`);
  },
};

// ---------------------------------------------------------------------
// `pretty` -- an opt-in, prettier rendering for cell output. A cell
// that `return`s a raw array/object gets the Inspector's default
// collapsed-JS-tree view; a cell that instead `return`s `pretty(value)`
// gets a shape-dispatched DOM rendering instead:
//
//   (a) array of Map      -- SPARQL bindings rows (Map keys = vars)
//                             -> a table, one column per variable.
//   (b) array of plain {} -- table from the union of keys.
//   (c) Dataset-like       -- (.size + Symbol.iterator yielding quads)
//                             -> a triples/quads table (s/p/o[/g]).
//   (d) plain object       -- a two-column key/value table.
//   (e) scalar/string      -- a small styled value span.
//   (f) anything else      -- returned unchanged; Inspector renders it.
//
// Term values (NamedNode/BlankNode/Literal, wherever they appear inside
// a table cell) are shortened for display -- an IRI compacts to its
// trailing path/fragment segment with the full IRI in a `title`
// tooltip, a literal is quoted (with @lang or ^^datatype suffix, full
// detail in the tooltip), a blank node gets a `_:` prefix. This is a
// browser-only DOM-returning implementation; the Node-side test harness
// (tests/hub/_helpers.mjs) provides a `pretty` stub with the same
// shape-dispatch that returns a plain, DOM-free structure instead, so
// pinned tests can assert on table shape without a browser. See
// docs/web/hub/README.md's cell-bindings table for the contract both
// sides implement.
// ---------------------------------------------------------------------

function prettyShortenIri(iri) {
  const m = /[/#]([^/#]+)$/.exec(iri);
  const tail = m ? m[1] : iri;
  return tail.length > 0 ? tail : iri;
}

// Render one RDF/JS-shaped term ({termType, value, [language],
// [datatype]}) as a compact <span> with the full detail in `title`;
// anything that isn't actually a term-shaped object is rendered as
// plain text so pretty() degrades gracefully on non-RDF data.
function prettyTermNode(term) {
  const span = document.createElement("span");
  span.className = "pretty-term";
  if (term && typeof term === "object" && typeof term.termType === "string") {
    if (term.termType === "NamedNode") {
      span.textContent = prettyShortenIri(term.value);
      span.title = term.value;
    } else if (term.termType === "BlankNode") {
      span.textContent = "_:" + term.value;
      span.title = "_:" + term.value;
    } else if (term.termType === "Literal") {
      let text = JSON.stringify(String(term.value));
      let detail = '"' + term.value + '"';
      if (term.language) {
        text += "@" + term.language;
        detail += "@" + term.language;
      } else if (term.datatype && term.datatype.value && term.datatype.value !== XSD_STRING) {
        text += "^^" + prettyShortenIri(term.datatype.value);
        detail += "^^<" + term.datatype.value + ">";
      }
      span.textContent = text;
      span.title = detail;
    } else if (term.termType === "Quad") {
      // RDF 1.2 triple term: render as <<( s p o )>> with inner terms
      // shortened (a nested triple-term object collapses to <<(…)>>).
      const part = (x) =>
        !x ? "" :
        x.termType === "Quad" ? "<<(…)>>" :
        x.termType === "Literal" ? JSON.stringify(String(x.value)) :
        x.termType === "BlankNode" ? "_:" + x.value :
        prettyShortenIri(x.value || "");
      span.textContent =
        "<<( " + part(term.subject) + " " + part(term.predicate) + " " + part(term.object) + " )>>";
      span.title = span.textContent;
    } else {
      span.textContent = String(term.value);
    }
  } else {
    span.textContent = term === undefined || term === null ? "" : String(term);
  }
  return span;
}

function prettyIsPlainObject(v) {
  if (typeof v !== "object" || v === null) return false;
  if (Array.isArray(v)) return false;
  if (v instanceof Map || v instanceof Set) return false;
  const proto = Object.getPrototypeOf(v);
  return proto === Object.prototype || proto === null;
}

function prettyIsDatasetLike(v) {
  return (
    typeof v === "object" && v !== null && !Array.isArray(v) &&
    !(v instanceof Map) && !(v instanceof Set) &&
    typeof v.size === "number" && typeof v[Symbol.iterator] === "function"
  );
}

// Render one SPARQL-Results-JSON-shaped term ({type: "uri"|"literal"|
// "bnode", value, [datatype], ["xml:lang"]}) the same way prettyTermNode
// renders an RDF/JS term -- a compact <span> with the full detail in
// `title`. A separate function from prettyTermNode because the SRJ
// shape (https://www.w3.org/TR/sparql11-results-json/) uses `type` not
// `termType`, and a plain-string `datatype` rather than a nested term.
function prettySrjTermNode(term) {
  const span = document.createElement("span");
  span.className = "pretty-term";
  if (term.type === "uri") {
    span.textContent = prettyShortenIri(term.value);
    span.title = term.value;
  } else if (term.type === "bnode") {
    span.textContent = "_:" + term.value;
    span.title = "_:" + term.value;
  } else if (term.type === "literal") {
    let text = JSON.stringify(String(term.value));
    let detail = '"' + term.value + '"';
    const lang = term["xml:lang"];
    if (lang) {
      text += "@" + lang;
      detail += "@" + lang;
    } else if (term.datatype && term.datatype !== XSD_STRING) {
      text += "^^" + prettyShortenIri(term.datatype);
      detail += "^^<" + term.datatype + ">";
    }
    span.textContent = text;
    span.title = detail;
  } else {
    span.textContent = String(term.value);
  }
  return span;
}

function prettyCellNode(value) {
  if (value && typeof value === "object" && typeof value.termType === "string") {
    return prettyTermNode(value);
  }
  if (
    value && typeof value === "object" && typeof value.value === "string" &&
    (value.type === "uri" || value.type === "literal" || value.type === "bnode")
  ) {
    return prettySrjTermNode(value);
  }
  // Any other plain object or array: a compact JSON rendering instead of
  // the useless "[object Object]" String() gives, with the full JSON in
  // `title`. Owner screenshot, 2026-08-25: the Table toggle showed
  // "[object Object]" in every cell of a row-object table because this
  // fallback used to be a bare String(value).
  if (value !== null && typeof value === "object") {
    const span = document.createElement("span");
    span.className = "pretty-value";
    const json = JSON.stringify(value);
    span.textContent = json.length > 80 ? json.slice(0, 80) + "…" : json;
    span.title = json;
    return span;
  }
  const span = document.createElement("span");
  span.textContent = value === undefined || value === null ? "" : String(value);
  return span;
}

function prettyCount(n, noun) {
  return n + " " + noun + (n === 1 ? "" : "s");
}

function prettyBuildTable(columns, rows, captionText) {
  const wrap = document.createElement("div");
  wrap.className = "pretty-table-wrap";

  const caption = document.createElement("div");
  caption.className = "pretty-caption";
  caption.textContent = captionText;
  wrap.appendChild(caption);

  const table = document.createElement("table");
  table.className = "pretty-table";

  const thead = document.createElement("thead");
  const headRow = document.createElement("tr");
  for (const col of columns) {
    const th = document.createElement("th");
    th.textContent = col;
    headRow.appendChild(th);
  }
  thead.appendChild(headRow);
  table.appendChild(thead);

  const tbody = document.createElement("tbody");
  for (const row of rows) {
    const tr = document.createElement("tr");
    for (const cell of row) {
      const td = document.createElement("td");
      td.appendChild(prettyCellNode(cell));
      tr.appendChild(td);
    }
    tbody.appendChild(tr);
  }
  table.appendChild(tbody);
  wrap.appendChild(table);
  return wrap;
}

function pretty(value) {
  // (a) array of Map -- SPARQL bindings rows.
  if (Array.isArray(value) && value.length > 0 && value.every((r) => r instanceof Map)) {
    const columns = [];
    for (const row of value) {
      for (const k of row.keys()) if (!columns.includes(k)) columns.push(k);
    }
    const rows = value.map((row) => columns.map((c) => (row.has(c) ? row.get(c) : "")));
    return prettyBuildTable(columns, rows, prettyCount(value.length, "row"));
  }

  // (c) Dataset-like -- checked ahead of the plain-object-array case
  // below since a Dataset is not itself an Array.
  if (prettyIsDatasetLike(value)) {
    const quads = [...value];
    const hasGraph = quads.some((q) => q && q.graph && q.graph.value);
    const columns = hasGraph ? ["s", "p", "o", "g"] : ["s", "p", "o"];
    const rows = quads.map((q) => {
      const row = [q.subject, q.predicate, q.object];
      if (hasGraph) row.push(q.graph || "");
      return row;
    });
    return prettyBuildTable(columns, rows, prettyCount(quads.length, "row"));
  }

  // (b) array of plain objects -- table from the union of keys.
  if (Array.isArray(value) && value.length > 0 && value.every(prettyIsPlainObject)) {
    const columns = [];
    for (const obj of value) {
      for (const k of Object.keys(obj)) if (!columns.includes(k)) columns.push(k);
    }
    const rows = value.map((obj) => columns.map((k) => (k in obj ? obj[k] : "")));
    return prettyBuildTable(columns, rows, prettyCount(value.length, "row"));
  }

  // (d) plain object -- two-column key/value table.
  if (prettyIsPlainObject(value)) {
    const entries = Object.entries(value);
    return prettyBuildTable(["key", "value"], entries, prettyCount(entries.length, "field"));
  }

  // (e) scalars/strings -- a simple styled value span.
  if (
    typeof value === "string" || typeof value === "number" ||
    typeof value === "boolean" || typeof value === "bigint"
  ) {
    const span = document.createElement("span");
    span.className = "pretty-value";
    span.textContent = String(value);
    return span;
  }

  // (f) anything else (null, undefined, DOM nodes, functions, a lone
  // Map, an empty array, ...) -- unchanged, so Inspector's own
  // renderer handles it.
  return value;
}

// Fixed bindings every cell gets access to, by parameter name — this
// is the whole "standard library" a hub post can rely on. Extend this
// list (and the mirrored `new Function(...)` parameter list below)
// deliberately; it's the interface post-authoring (wave B) writes
// against. See docs/web/hub/README.md for the full contract.
const CELL_BINDINGS = ["Factoidal", "fn", "d3", "Plot", "html", "md", "pretty", "L"];
main.variable().define("Factoidal", [], () => Factoidal);
main.variable().define("fn", [], () => fn);
main.variable().define("d3", [], () => d3);
main.variable().define("Plot", [], () => Plot);
// `html`/`md` are NOT bare exports of the Observable stdlib module —
// they live on a `Library` INSTANCE (`stdlib.html` is undefined, which
// made `html`... `` throw "undefined is not a function" in cells). Wire
// them from a Library instance: `library.html` is the tag factory the
// runtime invokes to yield the htl tag.
const stdlibLibrary = new stdlib.Library();
main.variable().define("html", [], stdlibLibrary.html);
main.variable().define("md", [], stdlibLibrary.md);
main.variable().define("pretty", [], () => pretty);
// Leaflet (third_party/leaflet/, vendored, no CDN) -- loaded above as a
// classic <script> that sets window.L; exposed as the `L` cell binding
// so a cell can build a map without touching `window` directly.
main.variable().define("L", [], () => window.L);

// ---------------------------------------------------------------------
// Reactive dataflow (ObservableHQ-style).
//
// `knownNames` is the set of names a cell may reference to create a
// reactive dependency: the fixed builtins above, plus every cell's
// declared name (a cell of the form `name = <expr>`). It's seeded with
// the builtins here and grows as pinned + reader cells declare names.
//
// For each cell, analyzeCell() (docs/web/hub/reactive-cells.mjs) returns
// its declared name (or null) and its referenced free identifiers;
// cellInputs() intersects those refs with `knownNames` to get the exact
// list of runtime inputs to wire. The vendored Observable runtime then
// computes the topological order and re-runs dependents whenever an
// input changes -- we never hand-order cells. Names NOT in `knownNames`
// (Math, JSON, document, ...) stay resolved through ordinary JS scope,
// so a standalone cell that references only globals + builtins behaves
// byte-for-byte as it did before reactivity was added.
//
// Async is handled by the runtime natively: an input whose value is a
// Promise (e.g. `graph = fn.parse(ttl)` returning a Promise, or a cell
// that `await`s) is resolved before any dependent's definition runs, so
// `query(graph, ...)` always sees a settled Dataset, never a pending
// Promise.
// ---------------------------------------------------------------------
const knownNames = new Set(CELL_BINDINGS);

// Compile one cell's source into a runtime variable definition + the
// inputs to wire it with. Shared by the initial mount and every Run.
// `makeDefinition` builds an async function whose parameters are exactly
// `inputs`, positionally matching how the runtime resolves and passes
// them; the body is the cell's value expression (with a `return`
// supplied for the `name = expr` form) or the verbatim body for an
// anonymous cell.
function compileCell(source) {
  const info = analyzeCell(source);
  const inputs = cellInputs(info, knownNames);
  return { name: info.name, inputs, definition: makeDefinition(inputs, info.body) };
}

// Output controller: values receive the same shape-aware `pretty()`
// rendering automatically. SPARQL bindings and RDF datasets become
// compact, scrollable tables; charts and DOM output pass through unchanged.
function createOutput(name) {
  const container = document.createElement("div");
  container.className = "observable-cell";

  const inspector = new Inspector(container);
  const inspectorFulfilled = inspector.fulfilled.bind(inspector);
  const inspectorRejected = inspector.rejected.bind(inspector);

  function paint(value) {
    container.classList.remove("observable-cell-error");
    inspectorFulfilled(pretty(value), name);
  }

  inspector.fulfilled = (value) => {
    paint(value);
  };
  inspector.rejected = (error, varName) => {
    container.classList.add("observable-cell-error");
    inspectorRejected(error, varName);
  };

  return {
    container,
    inspector,
  };
}

function mountCell(codeEl, index) {
  const pre = codeEl.closest("pre") || codeEl.parentElement;
  let currentSource = codeEl.textContent;
  let editing = false;

  // The runtime variable's name is the cell's declared name (so later
  // cells can reference it) or a stable per-index fallback for an
  // anonymous cell. It's fixed at mount; editing the body re-runs under
  // the same name so dependents stay wired.
  const runtimeName = analyzeCell(currentSource).name || ("hubCell" + index);

  // --- Editable source: a textarea seeded from the shipped code,
  // swapped in for the static <pre> by the Edit toggle. A textarea
  // (rather than a contenteditable region) is deliberate: iOS Safari's
  // contenteditable caret placement and undo stack are unreliable
  // (cursor jumps on re-render, inconsistent Enter-key node splitting),
  // whereas a plain textarea gets the native mobile keyboard, native
  // undo, and reliable autocorrect/autocapitalize suppression via
  // ordinary attributes -- exactly what code entry on a phone needs.
  const editor = document.createElement("textarea");
  editor.className = "observable-cell-editor";
  editor.spellcheck = false;
  editor.setAttribute("autocapitalize", "off");
  editor.setAttribute("autocorrect", "off");
  editor.setAttribute("autocomplete", "off");
  editor.setAttribute("wrap", "soft");
  editor.setAttribute("aria-label", "Cell source (editable)");
  editor.value = currentSource;
  editor.rows = Math.min(20, Math.max(3, currentSource.split("\n").length));
  editor.hidden = true;

  function autoGrow() {
    editor.style.height = "auto";
    editor.style.height = editor.scrollHeight + "px";
  }
  editor.addEventListener("input", autoGrow);
  editor.addEventListener("keydown", (ev) => {
    // Cmd/Ctrl+Enter: run the current source without leaving the
    // keyboard -- the desktop-friendly counterpart to the mobile Run
    // button.
    if ((ev.metaKey || ev.ctrlKey) && ev.key === "Enter") {
      ev.preventDefault();
      runCell();
    }
  });

  // --- Toolbar: Edit toggle + Run button, between the code and the
  // output box. Tap targets are >= 44px (see .observable-cell-btn);
  // deliberately quiet styling since the page is a blog first.
  const toolbar = document.createElement("div");
  toolbar.className = "observable-cell-toolbar";
  toolbar.title = "Edit the code above and tap Run to re-execute it live in your browser.";

  const editBtn = document.createElement("button");
  editBtn.type = "button";
  editBtn.className = "observable-cell-btn observable-cell-edit-btn";
  editBtn.textContent = "Edit";
  editBtn.setAttribute("aria-pressed", "false");
  editBtn.addEventListener("click", () => {
    if (editing) {
      // "Done": apply the edit (same as Run) THEN leave edit mode.
      // runCell() reads editor.value while `editing` is still true, so
      // it captures the change and updates currentSource before we
      // exit -- without this, Done silently discarded the edit (only
      // Run applied it), and re-opening Edit reset editor.value back
      // to the stale currentSource below.
      runCell();
      setEditing(false);
    } else {
      setEditing(true);
    }
  });

  const runBtn = document.createElement("button");
  runBtn.type = "button";
  runBtn.className = "observable-cell-btn observable-cell-run-btn";
  runBtn.textContent = "Run";
  runBtn.addEventListener("click", runCell);

  const output = createOutput(runtimeName);
  const container = output.container;
  container.setAttribute("data-hub-cell", String(index));

  toolbar.appendChild(editBtn);
  toolbar.appendChild(runBtn);

  // Discoverability: a phone has no hover, so a title attribute alone
  // (the desktop affordance above) is invisible on mobile -- the owner
  // report this change fixes. Spell it out visibly, once per page, on
  // the first cell only, so the read-flow isn't cluttered on every one.
  if (index === 0) {
    const hint = document.createElement("span");
    hint.className = "observable-cell-hint";
    hint.textContent = "Edit & re-run — computed in your browser.";
    toolbar.appendChild(hint);
  }

  function setEditing(on) {
    editing = on;
    pre.hidden = on;
    editor.hidden = !on;
    editBtn.textContent = on ? "Done" : "Edit";
    editBtn.setAttribute("aria-pressed", on ? "true" : "false");
    if (on) {
      editor.value = currentSource;
      requestAnimationFrame(() => {
        autoGrow();
        editor.focus();
      });
    }
  }

  pre.insertAdjacentElement("afterend", editor);
  editor.insertAdjacentElement("afterend", toolbar);
  toolbar.insertAdjacentElement("afterend", container);

  // The Inspector is wrapped by createOutput() above: a runtime error
  // (thrown during the cell's async body, on the initial run or any
  // subsequent Run) gets the existing .observable-cell-error styling,
  // a later successful Run clears it, and the output-format toggle can
  // re-render the cached value without re-running the cell.
  const inspector = output.inspector;

  function runCell() {
    const source = editing ? editor.value : currentSource;
    currentSource = source;
    codeEl.textContent = source; // keep the static view in sync for next Edit/toggle
    let compiled;
    try {
      // Re-analyze the (possibly edited) source: the inputs it references
      // may have changed, so we recompute them against knownNames.
      compiled = compileCell(source);
    } catch (err) {
      container.classList.add("observable-cell-error");
      container.textContent = "Cell parse error: " + err.message;
      return;
    }
    try {
      // module.redefine(name, inputs, definition): looks up the
      // already-defined variable by its stable runtimeName and re-runs
      // variable.define on it, so the SAME Variable (and therefore the
      // SAME attached Inspector/output node) recomputes with the new
      // inputs + body -- and the runtime re-runs every dependent cell
      // that references this name. See runtime.esm.js's module_redefine,
      // which throws if the name was never defined, hence the initial
      // define below runs first at mount.
      main.redefine(runtimeName, compiled.inputs, compiled.definition);
    } catch (err) {
      container.classList.add("observable-cell-error");
      container.textContent = "Cell define error: " + err.message;
    }
  }

  let mount0;
  try {
    mount0 = compileCell(currentSource);
  } catch (err) {
    container.classList.add("observable-cell-error");
    container.textContent = "Cell parse error: " + err.message;
    return;
  }

  try {
    main.variable(inspector).define(runtimeName, mount0.inputs, mount0.definition);
  } catch (err) {
    container.classList.add("observable-cell-error");
    container.textContent = "Cell define error: " + err.message;
  }
}

// ---------------------------------------------------------------------
// Reader-added cells. The pinned (```observable-js) cells above stay
// exactly as authored; this lets a reader turn the page into their own
// notebook -- append a fresh live cell (a textarea + Run) that evaluates
// through the SAME compileCell()/CELL_BINDINGS path (so `fn`,
// `Factoidal`, `Plot`, `d3`, `html`, `md`, `pretty` are all in scope),
// with the same output-format toggle, and Remove the ones they add.
// Each user cell gets its own runtime Variable (`userCell<seq>`); Remove
// calls variable.delete() to tear it out of the module cleanly.
// ---------------------------------------------------------------------

const USER_CELL_STARTER =
  "// Edit me, then tap Run. `fn`, `Factoidal`, `Plot`, `d3`, `html`,\n" +
  "// `md`, `pretty` and `L` (Leaflet) are all in scope. Try the Output: Table toggle.\n" +
  "return [\n" +
  "  { n: 1, square: 1 },\n" +
  "  { n: 2, square: 4 },\n" +
  "  { n: 3, square: 9 },\n" +
  "];";

let userCellSeq = 0;

function mountUserCell(listEl, initialSource) {
  const seq = userCellSeq++;
  const name = "userCell" + seq;

  const block = document.createElement("div");
  block.className = "hub-user-cell";
  block.setAttribute("data-hub-user-cell", String(seq));

  // Edit-first textarea (same reasons a textarea beats contenteditable
  // as documented for the pinned-cell editor: native mobile keyboard,
  // undo, and autocorrect/autocapitalize suppression).
  const editor = document.createElement("textarea");
  editor.className = "observable-cell-editor";
  editor.spellcheck = false;
  editor.setAttribute("autocapitalize", "off");
  editor.setAttribute("autocorrect", "off");
  editor.setAttribute("autocomplete", "off");
  editor.setAttribute("wrap", "soft");
  editor.setAttribute("aria-label", "Your cell source (editable)");
  editor.value = initialSource;
  editor.rows = Math.min(20, Math.max(3, initialSource.split("\n").length));

  function autoGrow() {
    editor.style.height = "auto";
    editor.style.height = editor.scrollHeight + "px";
  }
  editor.addEventListener("input", autoGrow);
  editor.addEventListener("keydown", (ev) => {
    if ((ev.metaKey || ev.ctrlKey) && ev.key === "Enter") {
      ev.preventDefault();
      runCell();
    }
  });

  const output = createOutput(name);
  const container = output.container;
  container.setAttribute("data-hub-cell", "user-" + seq);

  const toolbar = document.createElement("div");
  toolbar.className = "observable-cell-toolbar";

  const runBtn = document.createElement("button");
  runBtn.type = "button";
  runBtn.className = "observable-cell-btn observable-cell-run-btn";
  runBtn.textContent = "Run";
  runBtn.addEventListener("click", runCell);

  const removeBtn = document.createElement("button");
  removeBtn.type = "button";
  removeBtn.className = "observable-cell-btn observable-cell-remove-btn";
  removeBtn.textContent = "Remove";
  removeBtn.title = "Delete this cell you added";

  toolbar.appendChild(runBtn);
  toolbar.appendChild(removeBtn);

  block.appendChild(editor);
  block.appendChild(toolbar);
  block.appendChild(container);
  listEl.appendChild(block);

  // One runtime Variable per user cell. First Run creates it; every
  // later Run re-defines the SAME variable in place (the identical path
  // module.redefine takes internally) so the same output box recomputes.
  // Reader cells are reactive too: a `foo = ...` reader cell registers
  // `foo` into knownNames, so a later reader cell (or an edited pinned
  // cell) can reference it; an anonymous reader cell runs under the
  // stable fallback name and can reference any pinned cell's variable.
  let variable = null;

  function runCell() {
    const source = editor.value;
    let compiled;
    try {
      compiled = compileCell(source);
    } catch (err) {
      container.classList.add("observable-cell-error");
      container.textContent = "Cell parse error: " + err.message;
      return;
    }
    const runtimeName = compiled.name || name;
    try {
      if (compiled.name) knownNames.add(compiled.name);
      if (!variable) variable = main.variable(output.inspector);
      variable.define(runtimeName, compiled.inputs, compiled.definition);
    } catch (err) {
      container.classList.add("observable-cell-error");
      container.textContent = "Cell define error: " + err.message;
    }
  }

  removeBtn.addEventListener("click", () => {
    if (variable) {
      try { variable.delete(); } catch (err) { /* variable already gone */ }
      variable = null;
    }
    block.remove();
  });

  requestAnimationFrame(autoGrow);
  return { runCell };
}

function initUserCells() {
  const footer = document.querySelector("footer");
  const section = document.createElement("section");
  section.className = "hub-user-cells";

  const heading = document.createElement("h2");
  heading.textContent = "Your own cells";
  section.appendChild(heading);

  const intro = document.createElement("p");
  intro.className = "hub-user-cells-intro";
  intro.textContent =
    "Make this page your own notebook: add live cells that run in your " +
    "browser with the same fn, Factoidal, Plot, d3 and pretty scope as " +
    "the cells above. Edit the code, tap Run, and Remove the ones you " +
    "don't want. Nothing you add is saved or sent anywhere.";
  section.appendChild(intro);

  const list = document.createElement("div");
  list.className = "hub-user-cells-list";
  section.appendChild(list);

  const addBtn = document.createElement("button");
  addBtn.type = "button";
  addBtn.className = "observable-cell-btn hub-add-cell-btn";
  addBtn.textContent = "+ Add a cell";
  addBtn.addEventListener("click", () => {
    const cell = mountUserCell(list, USER_CELL_STARTER);
    cell.runCell(); // run the starter so the reader sees output immediately
  });
  section.appendChild(addBtn);

  if (footer && footer.parentNode) footer.parentNode.insertBefore(section, footer);
  else document.body.appendChild(section);
}

// Two passes so cross-cell references resolve regardless of document
// order. Pass 1: register every cell's declared name into knownNames,
// so a cell that references another cell's name (whether that cell
// appears earlier OR later on the page) wires it as a reactive input.
// Pass 2: mount each cell; the Observable runtime resolves the actual
// topological order and re-runs dependents itself.
const cellEls = [...document.querySelectorAll("pre > code.language-observable-js")];
for (const el of cellEls) {
  const declaredName = analyzeCell(el.textContent).name;
  if (declaredName) knownNames.add(declaredName);
}
cellEls.forEach((codeEl, index) => mountCell(codeEl, index));

initUserCells();
</script>
<script>
// Offline support (issue #69). Registered here too — hub posts render
// with this layout (not base.njk), so a visitor who deep-links straight
// to a hub page still registers the SW on first load. The SW's scope
// ("{{ '/' | url }}") is the whole site; base.njk registers the same
// worker, so whichever page a visitor lands on first, offline works.
if ("serviceWorker" in navigator) {
  window.addEventListener("load", () => {
    navigator.serviceWorker
      .register("{{ '/sw.js' | url }}?v={{ buildVersion }}", { scope: "{{ '/' | url }}" })
      .catch((err) => console.warn("[sw] registration failed", err));
  });

  let swRefreshing = false;
  navigator.serviceWorker.addEventListener("controllerchange", () => {
    if (swRefreshing) return;
    swRefreshing = true;
    window.location.reload();
  });
}
</script>
</body>
</html>
