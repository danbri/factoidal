  async owlClosure(data, mode) {
    // Factoidal.owlClosure takes N-Quads; page cells hand us Turtle.
    // Convert first or the ABI silently closes the EMPTY graph.
    const nq = await Factoidal.toRdf(data, { format: "turtle" });
    return Factoidal.owlClosure(nq, mode || 'RDFS');
