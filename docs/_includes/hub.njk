   * dataset). Divergence from `fn.query`: the Lean `datasetQuery`
   * envelope carries its own `"kind"` field (`"select"|"ask"|
   * "construct"`), so this dispatches on that instead of sniffing the
   * SPARQL text the way `fn.query`'s `sniffQueryForm` does for the
   * stateless F* ABI. A CONSTRUCT result comes back from
   * `datasetQuery` as plain N-Quads text with no handle of its own
   * (`Wasm/Ops/Query.lean`'s `queryParsedDataset` does not register one
   * for its result graph), so it is wrapped in a text-backed
   * `FnDataset`, not a further handle-backed `L4Dataset`.
   */
  async l4Query(dataset, sparql) {
    const r = dataset._engine.call("datasetQuery", [dataset.handle, sparql]);
    if (r.kind === "ask") return !!r.boolean;
    if (r.kind === "select") {
      const rows = (r.srj.results && r.srj.results.bindings) || [];
      return rows.map((row) => {
        const map = new Map();
        for (const [name, term] of Object.entries(row)) map.set(name, srjTermToFn(term));
        return map;
      });
    }
    if (r.kind === "construct") return new FnDataset(r.nquads);
    throw new Error(`l4Query: unexpected result kind "${r.kind}"`);
  },
