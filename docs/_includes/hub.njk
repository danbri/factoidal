   * Apply a SPARQL 1.1 Update to an L4Dataset. Divergence from
   * `fn.update` (which returns a NEW FnDataset, leaving its argument
   * untouched): `datasetUpdate` REPLACES the dataset stored under the
   * same handle (`Wasm/Ops/Handles.lean`), so this mutates `dataset`'s
   * cached size in place and returns the same object -- the handle
   * identity does not change, only what it refers to.
   */
  async l4Update(dataset, sparqlUpdate) {
    const r = dataset._engine.call("datasetUpdate", [dataset.handle, sparqlUpdate]);
    dataset._count = r.count;
    return dataset;
  },
