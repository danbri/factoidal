<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!--
  Content-Security-Policy (task #105). A `<meta http-equiv>` CSP is
  the only enforcement mechanism available on static GitHub Pages
  hosting (no per-request server, so no response header) -- this is
  the FIRST time this repo has stated the hub's CSP explicitly rather
  than relying on the informal "we just don't load anything external"
  convention (see third_party/leaflet/PROVENANCE.md, third_party/
  observable/README.md). Two variants, selected by the `hubMode` page
  variable (default "strict"; set to "live" only by web/hub-live.11ty.js's
  generated twins):

    strict (every ordinary hub post, e.g. /web/hub/21-.../) --
      img-src/connect-src are 'self' only: no tile host, no remote
      SPARQL endpoint, no network request of any kind can succeed.
      This is WHY post 21's map has no raster basemap -- not a bug,
      the policy this page states out loud.

    live (the /web/hub-live/<slug>/ twin -- see the banner below) --
      img-src and connect-src are additionally allowed `https:`, so a
      cell MAY load OSM tiles or query a remote SPARQL endpoint (e.g.
      the Fly.io demo). script-src and style-src are UNCHANGED between
      modes: no third-party *code* can execute in either mode, only
      third-party *data* (images, fetch responses) in live mode. That
      distinction is the whole supply-chain point of the split.

  Both variants carry 'unsafe-inline' and 'unsafe-eval' on script-src
  and 'unsafe-inline' on style-src -- pre-existing architectural
  requirements of this page, not something live mode introduces or
  strict mode could drop: the runtime script a few hundred lines below
  is itself an inline `<script type="module">` block (no per-request
  nonce is possible on static hosting), and web/hub/reactive-cells.mjs's
  makeDefinition() compiles every ```observable-js cell through `new
  Function(...)` at runtime (the whole reactive-cell mechanism this
  entire hub is built on). Every script SOURCE is still same-origin
  only in both modes -- no external <script src="https://..."> host is
  ever allowed, live mode or strict -- with one named exception: a
  post whose own front matter sets `hubAllowRegistryCdn: true` (only
  post 37, "Installed, not vendored", whose point is running the
  @factoidal/core code published to the npm registry) gets exactly
  `https://cdn.jsdelivr.net` and `https://unpkg.com` added to
  script-src and connect-src, in BOTH modes (owner decision,
  2026-08-25 -- before that the carve-out was live-twin-only and the
  default page showed "registry unreachable" in every cell). Per-page
  opt-in; every other post's policy is unchanged.

  `frame-ancestors` is deliberately NOT in the policy below: the CSP
  spec requires it be delivered as a real HTTP response header --
  every browser ignores it (with a console warning) when set via
  `<meta http-equiv>`. Including a directive the browser can't honor
  would just be console noise on every hub page for no enforcement
  gained.
-->
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'{% if hubAllowRegistryCdn %} https://cdn.jsdelivr.net https://unpkg.com{% endif %}; style-src 'self' 'unsafe-inline'; img-src 'self' data:{% if hubMode == 'live' %} https:{% endif %}; connect-src 'self'{% if hubMode == 'live' %} https:{% endif %}{% if hubAllowRegistryCdn %} https://cdn.jsdelivr.net https://unpkg.com{% endif %}; font-src 'self'; object-src 'none'; base-uri {% if hubMode == 'live' %}'self'{% else %}'none'{% endif %}">
<title>{{ title }}{% if hubMode == 'live' %} (live mode){% endif %} — Factoidal</title>
{% if hubMode == 'live' %}
<!--
  Live twins reuse the strict post's rendered HTML verbatim (see
  web/hub-live.11ty.js), so every RELATIVE URL in that content -- the
  post's prose links (../README/, ./24-hdt-.../) AND, more
  load-bearing, any page-relative fetch() a cell makes at runtime
  (post 24 fetches "../rml-core-ontology.hdt") -- was authored against
  the strict post's /web/hub/<slug>/ directory. This <base> makes all
  of them resolve there instead of against /web/hub-live/<slug>/,
  where they would 404. It's also why live mode's CSP above says
  base-uri 'self' where strict says 'none': strict pages have no
  <base> and ban the element outright; live pages need exactly this
  one, same-origin. Absolute paths (every `| url`-filtered asset in
  this layout) are unaffected. Known tradeoff: in-page fragment links
  (#section, the heading-anchor permalinks) also resolve against the
  base, so clicking one from a live twin lands on the strict page's
  section -- same content, strict capabilities; acceptable for a
  secondary view of the same post.
-->
<base href="{{ ('/web/hub/' + livePostSlug + '/') | url }}">
{% endif %}
<!--
  Vendored Leaflet (third_party/leaflet/, BSD-2-Clause, see its
  PROVENANCE.md) — same-origin, no CDN, passthrough-copied to
  /vendor/leaflet/ by docs/.eleventy.js. leaflet.js is Leaflet's own
  prebuilt UMD bundle: loaded as a classic (non-module) script it runs
  synchronously in document order and sets window.L, so it is ready
  before the `type="module"` script below (module scripts always defer
  until after parsing) reads window.L into the `L` cell binding.
  leaflet.css is required for Leaflet's panes/controls to lay out
  correctly even in the vector-only, no-tile-layer usage the hub's map
  cell makes.
-->
<link rel="stylesheet" href="{{ '/vendor/leaflet/leaflet.css' | url }}">
<script src="{{ '/vendor/leaflet/leaflet.js' | url }}"></script>
<script type="module" src="{{ '/web/hub/assets/sparql-result-elements.mjs' | url }}"></script>
<style>
  /* Mobile-first: base rules target a ~390px phone; the only
     widening is the max-width cap. No rule may cause page-level
     horizontal scroll — wide tables/code scroll inside their own
     box (overflow-x: auto). */
  body { font-family: system-ui, -apple-system, sans-serif; max-width: 820px; margin: 1em auto; padding: 0 1em; line-height: 1.6; color: #333; background: #fff; overflow-wrap: break-word; }
  @media (min-width: 720px) { body { margin: 2em auto; } }
  h1 { border-bottom: 2px solid #2d6a4f; padding-bottom: 0.3em; }
  h2 { margin-top: 1.8em; }
  a { color: #2d6a4f; }
  nav { margin-bottom: 1.5em; font-size: 0.95em; }
  nav a { display: inline-block; padding: 0.5em 0.9em 0.5em 0; }
  table { border-collapse: collapse; width: 100%; margin: 1em 0; display: block; overflow-x: auto; }
  @media (min-width: 720px) { table { display: table; overflow-x: visible; } }
  th, td { border: 1px solid #ddd; padding: 0.4em 0.8em; text-align: left; }
  th { background: #f5f5f5; }
  pre { background: #f8f8f8; padding: 1em; overflow-x: auto; border-radius: 4px; }
  code { background: #f0f0f0; padding: 0.15em 0.3em; border-radius: 3px; font-size: 0.9em; }
  pre code { background: none; padding: 0; }
  footer { margin-top: 3em; border-top: 1px solid #ddd; padding-top: 1em; font-size: 0.9em; color: #666; }
  @media (prefers-color-scheme: dark) {
    body { background: #121417; color: #d6dbe1; }
    a { color: #7fd0a7; }
    h1 { border-bottom-color: #7fd0a7; }
    th { background: #1d2126; }
    th, td { border-color: #333a42; }
    pre { background: #1a1e23; }
    code { background: #22272d; }
    footer { border-top-color: #333a42; color: #98a2ad; }
  }
  ul.post-series li.placeholder { color: #888; }
  ul.post-series li.placeholder::after { content: " (planned)"; font-style: italic; }

  /* Observable cell convention: a fenced ```observable-js block gets
     turned into a live cell rendered in the .observable-cell div the
     runtime script inserts right after it. See README below the
     fenced-block markup on this page, and hub-cells.js. */
  pre:has(> code.language-observable-js) {
    border-left: 3px solid #2d6a4f;
  }
  .observable-cell {
    margin: 0 0 1.4em;
    padding: 0.8em 1em;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #fff;
    min-height: 1.4em;
  }
  .observable-cell::before {
    content: "\21b3 live cell output";
    display: block;
    font-size: 0.75em;
    color: #888;
    margin-bottom: 0.4em;
  }
  .observable-cell.observable-cell-error {
    border-color: #c0392b;
    color: #c0392b;
    white-space: pre-wrap;
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
  }
  .observable-cell { overflow-x: auto; }
  .observable-cell svg { max-width: 100%; height: auto; }

  /* Leaflet map cells (docs/web/hub/21-geosparql-geometry-and-topology.md):
     an explicit, non-collapsing height is required -- Leaflet lays out
     its panes against the container's own box, and a height:0 div
     renders nothing. The plain background below is the vendored vector
     basemap's own background (docs/web/hub/assets/geo/), not a loading
     flash -- strict mode never shows a raster tile layer; live mode
     (data-hub-mode="live" on <body>) may add one on top of it. */
  .hub-leaflet-map {
    height: 420px;
    width: 100%;
    max-width: 100%;
    border-radius: 4px;
    background: #eef3ef;
  }
  @media (prefers-color-scheme: dark) {
    .hub-leaflet-map { background: #1a1e23; }
  }
  /* The Fullscreen API target is the map container itself (task #105) --
     Leaflet needs a real box size, not the UA's default fullscreen
     sizing, which for a `div` is "as big as its content" (still
     420px). :fullscreen / the vendor-prefixed variants restore full
     viewport sizing while active; the custom control's own JS calls
     map.invalidateSize() on the fullscreenchange event so Leaflet's
     panes catch up in the same frame. */
  .hub-leaflet-map:fullscreen,
  .hub-leaflet-map:-webkit-full-screen {
    height: 100vh;
    max-width: 100vw;
    border-radius: 0;
  }
  .leaflet-control-hub-fullscreen a {
    font-size: 1.1em;
    line-height: 26px;
    text-align: center;
  }
  /* The Leaflet layers control (live mode's OSM-tile toggle -- see the
     map cell's data-hub-mode="live" branch in post 21) styles its
     collapsed toggle with background-image: url(images/layers.png) in
     stock leaflet.css -- a PNG third_party/leaflet/PROVENANCE.md
     deliberately does NOT vendor. Replace it with a text glyph so the
     control never requests an image (same reasoning as the map's
     circleMarker-instead-of-default-icon choice: zero image assets).
     Equal specificity to leaflet.css's rule, but this <style> block
     comes after that <link>, so source order wins the cascade. */
  .leaflet-control-layers-toggle,
  .leaflet-retina .leaflet-control-layers-toggle {
    background-image: none;
  }
  .leaflet-control-layers-toggle::after {
    content: "\1F5FA"; /* world-map glyph */
    display: block;
    font-size: 20px;
    line-height: 36px;
    text-align: center;
  }
  .leaflet-touch .leaflet-control-layers-toggle::after {
    line-height: 44px;
  }

  /* Live-mode banner (task #105) -- present on every hub-live/<slug>/
     twin (loud, amber) and, in a quieter neutral form, on every
     ordinary strict post linking forward to its twin. Never shown on
     the hub index/README (no series_order), which have no twin. */
  .hub-live-banner {
    margin: 0 0 1.2em;
    padding: 0.7em 1em;
    border-radius: 4px;
    font-size: 0.92em;
    background: #fff3cd;
    border: 1px solid #f0d78c;
    color: #6b5613;
  }
  .hub-live-banner a { color: inherit; text-decoration: underline; }
  .hub-live-banner-strict {
    background: #eef6f1;
    border-color: #cfe4d7;
    color: inherit;
  }
  @media (prefers-color-scheme: dark) {
    .hub-live-banner { background: #3a3016; border-color: #5c4a1e; color: #f0d78c; }
    .hub-live-banner-strict { background: #16201a; border-color: #2d4738; color: #d6dbe1; }
  }

  /* `pretty()` cell-output tables (see hub.njk's module script) --
     reuses the page's own table/th/td rules for the grid itself; this
     adds the scrollable wrapper (both axes -- the existing
     overflow-x pattern plus a max-height/overflow-y cap for long
     results) and the small caption/term styling pretty() needs that
     nothing else on the page provides yet. */
  .pretty-table-wrap {
    max-height: 22em;
    overflow: auto;
    border: 1px solid #ddd;
    border-radius: 4px;
  }
  .pretty-table-wrap table { margin: 0; }
  .pretty-table-wrap thead th { position: sticky; top: 0; }
  .pretty-caption {
    font-size: 0.78em;
    color: #888;
    font-style: italic;
    padding: 0.3em 0.6em 0;
  }
  .pretty-term {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
  }
  .pretty-value {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: 0.95em;
    padding: 0.1em 0.4em;
    background: #f5f5f5;
    border-radius: 3px;
  }
  @media (prefers-color-scheme: dark) {
    .pretty-table-wrap { border-color: #333a42; }
    .pretty-caption { color: #98a2ad; }
    .pretty-value { background: #1d2126; }
  }

  /* Cell chrome: the toolbar (Edit toggle + Run button) sits between
     the code block and the output box. Mobile-first: tap targets are
     >= 44px, laid out in a wrapping flex row so the row never forces
     page-level horizontal scroll on a ~390px phone. */
  .observable-cell-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em;
    margin: 0.5em 0 0.8em;
  }
  .observable-cell-btn {
    box-sizing: border-box;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5em 1.1em;
    font: inherit;
    font-size: 0.85em;
    color: #2d6a4f;
    background: #f8f8f8;
    border: 1px solid #ddd;
    border-radius: 4px;
    cursor: pointer;
    line-height: 1.2;
  }
  .observable-cell-btn:hover { background: #eef6f1; }
  .observable-cell-btn:active { background: #e2efe8; }
  .observable-cell-btn[aria-pressed="true"] {
    background: #2d6a4f;
    color: #fff;
    border-color: #2d6a4f;
  }
  .observable-cell-hint {
    flex-basis: 100%;
    font-size: 0.78em;
    color: #888;
    font-style: italic;
  }
  .observable-cell-editor {
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
    background: #f8f8f8;
    border: 1px solid #ddd;
    border-left: 3px solid #2d6a4f;
    border-radius: 4px;
    padding: 1em;
    line-height: 1.5;
    color: inherit;
    resize: vertical;
    overflow-x: auto;
  }
  .observable-cell-editor:focus {
    outline: 2px solid #2d6a4f;
    outline-offset: -1px;
  }
  /* Same specificity as `.observable-cell-editor { display: block }`
     above, but author-origin `[hidden]` here needs the extra class in
     the selector to win the tie -- a bare UA `[hidden]` rule would
     lose to the author `display: block` declaration regardless of
     specificity, since normal author rules outrank normal
     user-agent rules irrespective of selector weight. */
  .observable-cell-editor[hidden] {
    display: none;
  }

  /* Reader-added cells (the "Add a cell" affordance): the reader can
     append their own live cells running in the same fn/Factoidal/Plot/
     d3/pretty scope as the pinned cells, and remove the ones they added.
     Same visual language as a pinned cell; width-constrained so the
     block never overflows horizontally on a narrow phone. */
  .hub-user-cells {
    margin-top: 2.5em;
    border-top: 1px solid #ddd;
    padding-top: 0.5em;
  }
  .hub-user-cells-intro { font-size: 0.9em; color: #666; }
  .hub-user-cell {
    margin: 0 0 1.6em;
    padding-left: 0.8em;
    border-left: 3px solid #2d6a4f;
  }
  .hub-add-cell-btn { margin-top: 0.5em; }
  .jsonld-playground {
    border: 1px solid #c8d8cf;
    border-radius: 0.65rem;
    padding: 1rem;
    background: #f7fbf8;
  }
  .jsonld-playground label { display: grid; gap: 0.4rem; font-weight: 600; }
  .jsonld-playground textarea {
    box-sizing: border-box;
    min-height: 15rem;
    width: 100%;
    resize: vertical;
    border: 1px solid #aebfb5;
    border-radius: 0.35rem;
    padding: 0.75rem;
    background: #fff;
    color: inherit;
    font: 0.88rem/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .jsonld-playground pre { max-height: 22rem; overflow: auto; white-space: pre-wrap; }

  @media (prefers-color-scheme: dark) {
    .observable-cell { background: #1a1e23; border-color: #333a42; }
    .observable-cell.observable-cell-error { border-color: #e07060; color: #e07060; }
    .observable-cell-btn { background: #1a1e23; border-color: #333a42; color: #7fd0a7; }
    .observable-cell-btn:hover { background: #232830; }
    .observable-cell-btn:active { background: #272d36; }
    .observable-cell-btn[aria-pressed="true"] { background: #7fd0a7; color: #10130f; border-color: #7fd0a7; }
    .observable-cell-render-label { color: #98a2ad; }
    .observable-cell-hint { color: #98a2ad; }
    .observable-cell-editor { background: #1a1e23; border-color: #333a42; border-left-color: #7fd0a7; }
    .observable-cell-editor:focus { outline-color: #7fd0a7; }
    .hub-user-cells { border-top-color: #333a42; }
    .hub-user-cells-intro { color: #98a2ad; }
  }
</style>
</head>
<body data-hub-mode="{{ hubMode | default('strict') }}">
<nav>
  <a href="{{ '/' | url }}">Home</a>
  <a href="{{ '/web/hub/' | url }}">Hub</a>
  <a href="{{ '/web/hub/47-writing-hub-notebooks/' | url }}">Notebook guide</a>
  <a href="{{ '/test-results/' | url }}">Test Results</a>
  <a href="https://github.com/danbri/factoidal">GitHub</a>
</nav>
{% if hubMode == 'live' %}
<div class="hub-live-banner" role="note">
  <strong>Live mode</strong> — this page may load external map tiles
  and query remote endpoints; the
  <a href="{{ ('/web/hub/' + livePostSlug + '/') | url }}">standard hub</a>
  is fully self-contained (same cells, no network).
</div>
{% elif series_order is defined and hubAllowRegistryCdn %}
<div class="hub-live-banner hub-live-banner-strict" role="note">
  This page loads the published @factoidal/core package from
  cdn.jsdelivr.net / unpkg.com — the only external hosts its
  Content-Security-Policy allows. A
  <a href="{{ ('/web/hub-live/' + page.fileSlug + '/') | url }}">live mode</a>
  twin of this same post can also load map tiles and remote SPARQL
  endpoints.
</div>
{% elif series_order is defined %}
<div class="hub-live-banner hub-live-banner-strict" role="note">
  This page is fully self-contained: no external network request is
  possible (see the Content-Security-Policy above). A
  <a href="{{ ('/web/hub-live/' + page.fileSlug + '/') | url }}">live mode</a>
  twin of this same post can load map tiles and remote SPARQL
  endpoints.
</div>
{% endif %}
{{ content | safe }}
<footer>
Factoidal — verified RDF/SPARQL from F*. Interactive cells on this
page run entirely in your browser via the F*-extracted engine and a
vendored Observable runtime — no server, no CDN{% if hubMode == 'live' %}
for any code; in live mode a cell may additionally load external map
tiles or query remote SPARQL endpoints (data, never scripts){% endif %}.
</footer>

<!--
  Runtime wiring for the ```observable-js cell convention. Loaded as a
  module so import specifiers resolve; all imports are same-origin
  Pages paths (respecting the /factoidal/ pathPrefix via the `url`
  filter), never a CDN. See third_party/observable/README.md and
  docs/web/hub/README.md for the convention this implements.
-->
<script type="module">
import { Runtime } from "{{ '/vendor/observable/runtime.esm.js' | url }}";
import { Inspector } from "{{ '/vendor/observable/inspector.esm.js' | url }}";
import * as Factoidal from "{{ '/npm/factoidal/browser.js' | url }}";
import * as d3 from "{{ '/vendor/observable/d3.esm.js' | url }}";
import * as Plot from "{{ '/vendor/observable/plot.esm.js' | url }}";
import * as stdlib from "{{ '/vendor/observable/stdlib.esm.js' | url }}";
// Project-owned reactive-cell compiler (NOT vendored third-party) --
// same-origin, no CDN. Turns `name = expr` cells into named runtime
// variables and infers each cell's cross-cell inputs. Shared verbatim
// with the Node pinning harness (tests/hub/_helpers.mjs) so the browser
// and the tests can never disagree about dependency inference. See
// docs/web/hub/reactive-cells.mjs for the compiler and its limits.
import { analyzeCell, cellInputs, makeDefinition } from "{{ '/vendor/hub/reactive-cells.mjs' | url }}";

const runtime = new Runtime();
const main = runtime.module();

// ---------------------------------------------------------------------
// `fn` — the typed, Dataset-returning cell surface.
//
// `Factoidal` (browser.js) is a raw, single-shot CLI wrapper: strings
// in, SPARQL-JSON out (no Dataset, no Map<string, Term> bindings). The
// typed API most hub posts are written against (`parse()` -> Dataset,
// `query()` -> Bindings[] | boolean | Dataset) lives in
// npm/factoidal/index.js, but that module is Node-only (CommonJS
// `require`, `node:fs`, `node:crypto`) and cannot load in a browser
// `<script type="module">` context. Rather than fork the engine or
// re-mirror a browser build of it (both out of scope — see
// docs/web/hub/README.md), this adapter reshapes `Factoidal`'s raw
// CLI calls into the same external contract, entirely client-side:
// parse() returns a small frozen Dataset-like wrapper over the
// engine's own N-Quads dump; query() sniffs the query form (same
// heuristic as npm/factoidal/lib/api.js's sniffQueryForm) to decide
// whether to return an array of Map<string, Term> (SELECT), a
// boolean (ASK), or another Dataset-like wrapper (CONSTRUCT). See
// docs/web/hub/README.md for the full contract every post's cells are
// written against.
// ---------------------------------------------------------------------

const XSD_STRING = "http://www.w3.org/2001/XMLSchema#string";
const RDF_LANGSTRING = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString";

function parseNQuadsTerm(str, i) {
  while (i < str.length && (str[i] === " " || str[i] === "\t")) i++;
  // RDF 1.2 triple term: <<( s p o )>> -> a Quad-shaped term. Checked
  // before the '<' IRI case (a triple term also opens with '<').
  if (str[i] === "<" && str[i + 1] === "<" && str[i + 2] === "(") {
    let j = i + 3;
    const [subject, a]   = parseNQuadsTerm(str, j); j = a;
    const [predicate, b] = parseNQuadsTerm(str, j); j = b;
    const [object, c]    = parseNQuadsTerm(str, j); j = c;
    while (j < str.length && /\s/.test(str[j])) j++;
    if (str[j] === ")" && str[j + 1] === ">" && str[j + 2] === ">") {
      return [{ termType: "Quad", value: "", subject, predicate, object }, j + 3];
    }
    throw new Error("parseNQuads: unterminated triple term at offset " + i);
  }
  if (str[i] === "<") {
    const end = str.indexOf(">", i);
    return [{ termType: "NamedNode", value: str.slice(i + 1, end) }, end + 1];
  }
  if (str[i] === "_" && str[i + 1] === ":") {
    let j = i + 2;
    while (j < str.length && !/\s/.test(str[j])) j++;
    return [{ termType: "BlankNode", value: str.slice(i + 2, j) }, j];
  }
  if (str[i] === '"') {
    let j = i + 1;
    let lex = "";
    while (str[j] !== '"') {
      if (str[j] === "\\") { lex += str[j] + str[j + 1]; j += 2; }
      else { lex += str[j]; j++; }
    }
    j++; // closing quote
    lex = lex
      .replace(/\\"/g, '"').replace(/\\n/g, "\n")
      .replace(/\\t/g, "\t").replace(/\\r/g, "\r")
      .replace(/\\\\/g, "\\");
    let datatype = XSD_STRING;
    let language = "";
    if (str[j] === "@") {
      let k = j + 1;
      while (k < str.length && /[a-zA-Z0-9-]/.test(str[k])) k++;
      language = str.slice(j + 1, k);
      datatype = RDF_LANGSTRING;
      j = k;
    } else if (str[j] === "^" && str[j + 1] === "^") {
      const start = j + 3; // skip ^^<
      const end = str.indexOf(">", start);
      datatype = str.slice(start, end);
      j = end + 1;
    }
    return [
      { termType: "Literal", value: lex, language, datatype: { termType: "NamedNode", value: datatype } },
      j,
    ];
  }
  throw new Error("parseNQuads: unrecognized term at offset " + i + " in: " + str);
}

function parseNQuadsLine(line) {
  const terms = [];
  let i = 0;
  while (terms.length < 4) {
    while (i < line.length && (line[i] === " " || line[i] === "\t")) i++;
    if (line[i] === "." && (i + 1 >= line.length || /\s/.test(line[i + 1]))) break;
    const [term, next] = parseNQuadsTerm(line, i);
    terms.push(term);
    i = next;
  }
  const [subject, predicate, object, graph] = terms;
  return { subject, predicate, object, graph: graph || null };
}

// Parse N-Triples/N-Quads text (as produced by Factoidal.toRdf() /
// Factoidal.query({output: 'ntriples'})) into an array of quad-shaped
// objects: {subject, predicate, object, graph}, each term
// {termType, value, [language], [datatype]} — the same shape RDF/JS
// terms expose for the fields these hub posts read.
function parseNQuads(text) {
  return text
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l.length > 0 && !l.startsWith("#"))
    .map(parseNQuadsLine);
}

class FnDataset {
  constructor(nquadsText) {
    this._text = nquadsText;
    this._quads = parseNQuads(nquadsText);
  }
  get size() { return this._quads.length; }
  [Symbol.iterator]() { return this._quads[Symbol.iterator](); }
  toNQuads() { return this._text; }
}

// Lean twin of FnDataset (issue #585's page-level half: typed wrappers
// over the dataset-handle ABI, `Wasm/Ops/Handles.lean`, so a hub cell
// never has to carry N-Quads text through fn.l4Call itself). Where
// FnDataset holds the parsed text in JS, L4Dataset holds a HANDLE --
// the dataset stays parsed once, inside the wasm module's own store,
// and every op after `fn.l4Parse` sends only the handle string. Same
// external shape as FnDataset (`size`, `toNQuads()`) so the two engines'
// cells read symmetrically; `_engine`/`handle` are read by
// `fn.l4Query`/`fn.l4Update`, not meant for a cell to touch directly.
class L4Dataset {
  constructor(engine, handle, count) {
    this._engine = engine;
    this._handle = handle;
    this._count = count;
  }
  get size() { return this._count; }
  get handle() { return this._handle; }
  toNQuads() {
    return this._engine.call("datasetSerialize", [this._handle, "nquads"]).nquads;
  }
  /** Prefix-compacted Turtle of the same handle (datasetSerialize's other format). */
  toTurtle() {
    return this._engine.call("datasetSerialize", [this._handle, "turtle"]).turtle;
  }
}

// Same heuristic as npm/factoidal/lib/api.js's sniffQueryForm: blank
// out IRIs/comments first so '#' inside a PREFIX IRI or a keyword
// appearing inside a string literal can't hide/fake the query verb.
function sniffQueryForm(sparql) {
  const cleaned = String(sparql).replace(/<[^>]*>/g, " ").replace(/#[^\n]*/g, " ");
  const m = cleaned.match(/\b(select|ask|construct|describe)\b/i);
  return m ? m[1].toLowerCase() : "select";
}

function srjTermToFn(t) {
  if (t.type === "uri") return { termType: "NamedNode", value: t.value };
  if (t.type === "bnode") return { termType: "BlankNode", value: t.value };
  if (t.type === "triple") {
    // RDF 1.2 triple term in SPARQL Results JSON -> a Quad-shaped term.
    const v = t.value || {};
    return {
      termType: "Quad", value: "",
      subject: srjTermToFn(v.subject),
      predicate: srjTermToFn(v.predicate),
      object: srjTermToFn(v.object),
    };
  }
  // 'literal' | 'typed-literal'
  const language = t["xml:lang"] || "";
  const datatype = t.datatype || (language ? RDF_LANGSTRING : XSD_STRING);
  return { termType: "Literal", value: t.value, language, datatype: { termType: "NamedNode", value: datatype } };
}

// Reshape a RAW, CLI-shaped Factoidal module (query/toRdf/canonicalize/
// registerExtensionFunction/version, same shape as npm/factoidal/
// browser.js's own exports -- see "Why `fn` is an adapter, not an
// import" in docs/web/hub/README.md) into the typed Dataset-based shape
// `fn` exposes. `fn.parse`/`fn.query` below are this same reshaping
// hardcoded to the module-scope `Factoidal` (the same-origin bundle);
// this is the parameterized version, used by `fn.loadRegistryPackage`
// (post 37) to apply IDENTICAL reshaping to whichever raw module a
// cell loaded from the npm registry CDN, so a cell can call
// `registry.parse(...)`/`registry.query(...)` with the exact same
// contract as `fn.parse`/`fn.query`.
function makeTypedApiOverRaw(raw) {
  return {
    version: raw.version,
    async parse(text, options) {
      const opts = options || {};
      const nq = await raw.toRdf(text, { format: opts.format || "turtle", baseIRI: opts.baseIRI });
      return new FnDataset(nq);
    },
    async query(dataset, sparql, options) {
      const opts = options || {};
      const entail = opts.entail || "none";
      const sparql12 = opts.sparql12 === true || String(opts.version || "") === "1.2";
      const form = sniffQueryForm(sparql);
      if (form === "construct" || form === "describe") {
        const nt = await raw.query(dataset.toNQuads(), sparql, {
          dataFormat: "nquads", entail, output: "ntriples", sparql12,
        });
        return new FnDataset(nt);
      }
      const result = await raw.query(dataset.toNQuads(), sparql, {
        dataFormat: "nquads", entail, output: "json", sparql12,
      });
      if (form === "ask") return !!result.boolean;
      const rows = (result.results && result.results.bindings) || [];
      return rows.map((row) => {
        const map = new Map();
        for (const [name, term] of Object.entries(row)) map.set(name, srjTermToFn(term));
        return map;
      });
    },
    async canonicalize(text, options) { return raw.canonicalize(text, options); },
    async registerExtensionFunction(iri, f) { return raw.registerExtensionFunction(iri, f); },
  };
}

const fn = {
  /**
   * Certified core-RDFS closure + its decidable fragment check (post
   * 32: the six-rule operator with the decides-iff). "corerdfs" is the
   * API name for the fragment the literature calls ρdf (Muñoz, Pérez &
   * Gutierrez 2009); the rhoDf* names are literature-name aliases.
   * Thin delegations to the browser adapter, same as lib/api.js.
   */
  async coreRdfsClosure(data) { return Factoidal.coreRdfsClosure(data); },
  async coreRdfsCheck(data) { return Factoidal.coreRdfsCheck(data); },
  async rdfsPlusClosure(data) { return Factoidal.rdfsPlusClosure(data); },
  async rhoDfClosure(data) { return Factoidal.coreRdfsClosure(data); },
  async rhoDfFragmentCheck(data) { return Factoidal.coreRdfsCheck(data); },
