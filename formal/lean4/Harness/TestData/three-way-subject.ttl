@prefix ex: <http://example.org/> .

ex:alice ex:type ex:Person ; ex:name "Alice" ; ex:member ex:team1 .
ex:bob ex:type ex:Person ; ex:name "Bob" .
ex:carol ex:type ex:Robot ; ex:name "Carol" ; ex:member ex:team2 .
# Four matching BGP solutions: two names × two team memberships.  This is
# deliberately a non-functional RDF shape, so the direct physical join must
# retain the normal SPARQL Cartesian-product/bag behavior.
ex:dana ex:type ex:Person ; ex:name "Dana", "Dana D." ; ex:member ex:team3, ex:team4 .
