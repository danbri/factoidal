################################################################

# ── Bass Drum ────────────────────────────────────────────────────────────────

:pBdDecay a val:Param ; val:slot 1 ;
    val:target :bdAmpEnv ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "bd_decay" ; val:section "Bass Drum" ;
    units:unit units:ms ; lv2:minimum 50.0 ; lv2:maximum 2000.0 .

:pBdTune a val:Param ; val:slot 2 ;
    val:target :bdPitchScale ; val:property val:min ;
    lv2:name "Tune" ; lv2:symbol "bd_tune" ; val:section "Bass Drum" ;
    units:unit units:hz ; lv2:minimum 30.0 ; lv2:maximum 120.0 .

:pBdDrive a val:Param ; val:slot 3 ;
    val:target :bdSat ; val:property val:drive ;
    lv2:name "Drive" ; lv2:symbol "bd_drive" ; val:section "Bass Drum" ;
    lv2:minimum 0.5 ; lv2:maximum 10.0 .

:pBdLevel a val:Param ; val:slot 15 ;
    val:target :bdLevel ; val:property val:gain ;
    lv2:name "Level" ; lv2:symbol "bd_level" ; val:section "Bass Drum" ;
    units:unit units:db ; lv2:minimum -60.0 ; lv2:maximum 12.0 .

:pBdPan a val:Param ; val:slot 24 ;
    val:target :bdPan ; val:property val:pan ;
    lv2:name "Pan" ; lv2:symbol "bd_pan" ; val:section "Bass Drum" ;
    lv2:minimum -1.0 ; lv2:maximum 1.0 .

