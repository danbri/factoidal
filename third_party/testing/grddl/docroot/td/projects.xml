      <gnm:Cells>
        <gnm:Cell Col="0" Row="0" ValueType="60">A few Semantic Web Tools</gnm:Cell>
        <gnm:Cell Col="0" Row="1" ValueType="60">title</gnm:Cell>
        <gnm:Cell Col="1" Row="1" ValueType="60">identifier</gnm:Cell>
        <gnm:Cell Col="2" Row="1" ValueType="60">description</gnm:Cell>
        <gnm:Cell Col="0" Row="2" ValueType="60">AutoSemantix</gnm:Cell>
        <gnm:Cell Col="1" Row="2" ValueType="60">http://autosemantix.sourceforge.net/</gnm:Cell>
        <gnm:Cell Col="2" Row="2" ValueType="60">AutoSemantix is a round-trip code generation tool designed to streamline the creation of Semantic Web applications for the Java platform</gnm:Cell>
        <gnm:Cell Col="0" Row="3" ValueType="60">BBN OWL Validator</gnm:Cell>
        <gnm:Cell Col="1" Row="3" ValueType="60">http://owl.bbn.com/validator/</gnm:Cell>
        <gnm:Cell Col="2" Row="3" ValueType="60">BBN OWL Validator</gnm:Cell>
        <gnm:Cell Col="0" Row="4" ValueType="60">Beagle++</gnm:Cell>
        <gnm:Cell Col="1" Row="4" ValueType="60">http://beagle.kbs.uni-hannover.de/index.html</gnm:Cell>
        <gnm:Cell Col="2" Row="4" ValueType="60">Beagle++ is an extensions to the Beagle search tool for the personal information space. Beagle++ now makes that search semantic, moving towards a visious of the Semantic Desktop</gnm:Cell>
        <gnm:Cell Col="0" Row="5" ValueType="60">Bibster</gnm:Cell>
        <gnm:Cell Col="1" Row="5" ValueType="60">http://bibster.semanticweb.org/</gnm:Cell>
        <gnm:Cell Col="2" Row="5" ValueType="60">A semantics-based bibliographic peer-to-peer system</gnm:Cell>
        <gnm:Cell Col="0" Row="6" ValueType="60">Bossam</gnm:Cell>
        <gnm:Cell Col="1" Row="6" ValueType="60">http://mknows.etri.re.kr/bossam/</gnm:Cell>
        <gnm:Cell Col="2" Row="6" ValueType="60">Bossam, a rule-based OWL reasoner (free, well-documented, closed-source)</gnm:Cell>
