{
  "provenance": "REC-cited Content MathML evaluation corpus. Each test is derived from a worked <apply> construction in the MathML 3.0 (2nd Ed.) Recommendation, Chapter 4 (Content Markup) / the OpenMath Content Dictionaries it references (arith1, relation1, integer1). No public machine-checkable Content-MathML numeric-evaluation suite exists (the W3C/browser MathML test suites are Presentation/rendering tests); this corpus is authored per the project's endorsed spec-cited pattern (docs/designissues/2026-07-05-xforms-model-program-plan.md Stage-1). See README.md.",
  "spec": "https://www.w3.org/TR/MathML3/ (chapter 4, Content Markup)",
  "tests": [
    { "name": "cn-integer", "spec": "MathML3 §4.4.1.1 cn (integer)", "input": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><cn>42</cn></math>", "expectedValue": "42" },
    { "name": "cn-integer-negative", "spec": "MathML3 §4.4.1.1 cn (integer)", "input": "<math><cn>-17</cn></math>", "expectedValue": "-17" },
    { "name": "cn-real", "spec": "MathML3 §4.4.1.1 cn (real)", "input": "<math><cn type=\"real\">3.14</cn></math>", "expectedValue": "157/50" },
    { "name": "cn-real-enotation", "spec": "MathML3 §4.4.1.1 cn (real, e-notation)", "input": "<math><cn>1.5e2</cn></math>", "expectedValue": "150" },
    { "name": "cn-rational", "spec": "MathML3 §4.4.1.1 cn type=rational (a<sep/>b)", "input": "<math><cn type=\"rational\">3<sep/>4</cn></math>", "expectedValue": "3/4" },
    { "name": "cn-rational-reduces", "spec": "MathML3 §4.4.1.1 cn type=rational", "input": "<math><cn type=\"rational\">6<sep/>4</cn></math>", "expectedValue": "3/2" },
    { "name": "ci-variable", "spec": "MathML3 §4.4.1.2 ci (identifier), bound via env", "input": "<math><apply><plus/><ci>x</ci><cn>1</cn></apply></math>", "expectedValue": "42", "env": { "x": "41" } },
    { "name": "ci-times", "spec": "MathML3 §4.4.1.2 ci; §4.4.3 times", "input": "<math><apply><times/><ci>x</ci><ci>y</ci></apply></math>", "expectedValue": "42", "env": { "x": "6", "y": "7" } },
    { "name": "ci-unbound", "spec": "MathML3 §4.4.1.2 ci (no binding => undefined)", "input": "<math><ci>z</ci></math>", "expectedValue": "undef" },

    { "name": "plus-binary", "spec": "MathML3 §4.4.3 plus (arith1.plus)", "input": "<math><apply><plus/><cn>2</cn><cn>3</cn></apply></math>", "expectedValue": "5" },
    { "name": "plus-nary", "spec": "MathML3 §4.4.3 plus (n-ary)", "input": "<math><apply><plus/><cn>1</cn><cn>2</cn><cn>3</cn><cn>4</cn></apply></math>", "expectedValue": "10" },
    { "name": "plus-rationals", "spec": "MathML3 §4.4.3 plus over rationals", "input": "<math><apply><plus/><cn type=\"rational\">1<sep/>2</cn><cn type=\"rational\">1<sep/>3</cn></apply></math>", "expectedValue": "5/6" },
    { "name": "minus-binary", "spec": "MathML3 §4.4.3 minus (binary)", "input": "<math><apply><minus/><cn>10</cn><cn>4</cn></apply></math>", "expectedValue": "6" },
    { "name": "minus-unary", "spec": "MathML3 §4.4.3 minus (unary negation)", "input": "<math><apply><minus/><cn>5</cn></apply></math>", "expectedValue": "-5" },
    { "name": "minus-rationals", "spec": "MathML3 §4.4.3 minus over rationals", "input": "<math><apply><minus/><cn type=\"rational\">1<sep/>2</cn><cn type=\"rational\">1<sep/>3</cn></apply></math>", "expectedValue": "1/6" },
    { "name": "times-binary", "spec": "MathML3 §4.4.3 times (arith1.times)", "input": "<math><apply><times/><cn>6</cn><cn>7</cn></apply></math>", "expectedValue": "42" },
    { "name": "times-rationals", "spec": "MathML3 §4.4.3 times over rationals", "input": "<math><apply><times/><cn type=\"rational\">1<sep/>2</cn><cn type=\"rational\">2<sep/>3</cn></apply></math>", "expectedValue": "1/3" },
    { "name": "divide-exact", "spec": "MathML3 §4.4.3 divide (exact)", "input": "<math><apply><divide/><cn>10</cn><cn>2</cn></apply></math>", "expectedValue": "5" },
    { "name": "divide-rational", "spec": "MathML3 §4.4.3 divide (non-integer)", "input": "<math><apply><divide/><cn>22</cn><cn>7</cn></apply></math>", "expectedValue": "22/7" },
    { "name": "divide-by-zero", "spec": "MathML3 §4.4.3 divide (0 divisor => undefined)", "input": "<math><apply><divide/><cn>1</cn><cn>0</cn></apply></math>", "expectedValue": "undef" },

    { "name": "power-integer", "spec": "MathML3 §4.4.3 power (arith1.power)", "input": "<math><apply><power/><cn>2</cn><cn>10</cn></apply></math>", "expectedValue": "1024" },
    { "name": "power-negative-exp", "spec": "MathML3 §4.4.3 power (negative integer exponent)", "input": "<math><apply><power/><cn>2</cn><cn>-2</cn></apply></math>", "expectedValue": "1/4" },
    { "name": "power-rational-base", "spec": "MathML3 §4.4.3 power (rational base)", "input": "<math><apply><power/><cn type=\"rational\">3<sep/>2</cn><cn>2</cn></apply></math>", "expectedValue": "9/4" },
    { "name": "power-zero-zero", "spec": "MathML3 §4.4.3 power (0^0 = 1 convention)", "input": "<math><apply><power/><cn>0</cn><cn>0</cn></apply></math>", "expectedValue": "1" },
    { "name": "power-noninteger-exp", "spec": "MathML3 §4.4.3 power (irrational, non-exact => undefined)", "input": "<math><apply><power/><cn>2</cn><cn type=\"rational\">1<sep/>2</cn></apply></math>", "expectedValue": "undef" },

    { "name": "root-sqrt-perfect", "spec": "MathML3 §4.4.3 root (default degree 2)", "input": "<math><apply><root/><cn>16</cn></apply></math>", "expectedValue": "4" },
    { "name": "root-degree-3", "spec": "MathML3 §4.4.3 root with <degree>", "input": "<math><apply><root/><degree><cn>3</cn></degree><cn>27</cn></apply></math>", "expectedValue": "3" },
    { "name": "root-rational", "spec": "MathML3 §4.4.3 root of a perfect-square rational", "input": "<math><apply><root/><cn type=\"rational\">1<sep/>4</cn></apply></math>", "expectedValue": "1/2" },
    { "name": "root-inexact", "spec": "MathML3 §4.4.3 root (irrational => undefined)", "input": "<math><apply><root/><cn>2</cn></apply></math>", "expectedValue": "undef" },

    { "name": "abs-negative", "spec": "MathML3 §4.4.3 abs (arith1.abs)", "input": "<math><apply><abs/><cn>-7</cn></apply></math>", "expectedValue": "7" },
    { "name": "abs-rational", "spec": "MathML3 §4.4.3 abs over a rational", "input": "<math><apply><abs/><apply><divide/><cn>-3</cn><cn>4</cn></apply></apply></math>", "expectedValue": "3/4" },

    { "name": "quotient", "spec": "MathML3 §4.4.3 quotient (integer1.quotient)", "input": "<math><apply><quotient/><cn>17</cn><cn>5</cn></apply></math>", "expectedValue": "3" },
    { "name": "quotient-by-zero", "spec": "MathML3 §4.4.3 quotient (0 divisor => undefined)", "input": "<math><apply><quotient/><cn>17</cn><cn>0</cn></apply></math>", "expectedValue": "undef" },
    { "name": "rem", "spec": "MathML3 §4.4.3 rem (integer1.remainder)", "input": "<math><apply><rem/><cn>17</cn><cn>5</cn></apply></math>", "expectedValue": "2" },
    { "name": "factorial-5", "spec": "MathML3 §4.4.3 factorial (integer1.factorial)", "input": "<math><apply><factorial/><cn>5</cn></apply></math>", "expectedValue": "120" },
    { "name": "factorial-0", "spec": "MathML3 §4.4.3 factorial (0! = 1)", "input": "<math><apply><factorial/><cn>0</cn></apply></math>", "expectedValue": "1" },

    { "name": "gcd-binary", "spec": "MathML3 §4.4.3 gcd (arith1.gcd)", "input": "<math><apply><gcd/><cn>12</cn><cn>18</cn></apply></math>", "expectedValue": "6" },
    { "name": "gcd-nary", "spec": "MathML3 §4.4.3 gcd (n-ary)", "input": "<math><apply><gcd/><cn>24</cn><cn>36</cn><cn>60</cn></apply></math>", "expectedValue": "12" },
    { "name": "max-binary", "spec": "MathML3 §4.4.3 max (minmax1.max)", "input": "<math><apply><max/><cn>3</cn><cn>7</cn></apply></math>", "expectedValue": "7" },
    { "name": "max-nary", "spec": "MathML3 §4.4.3 max (n-ary)", "input": "<math><apply><max/><cn>3</cn><cn>9</cn><cn>5</cn><cn>1</cn></apply></math>", "expectedValue": "9" },
    { "name": "min-binary", "spec": "MathML3 §4.4.3 min (minmax1.min)", "input": "<math><apply><min/><cn>3</cn><cn>7</cn></apply></math>", "expectedValue": "3" },

    { "name": "eq-true", "spec": "MathML3 §4.4.4 eq (relation1.eq)", "input": "<math><apply><eq/><cn>2</cn><cn>2</cn></apply></math>", "expectedValue": "true" },
    { "name": "eq-false", "spec": "MathML3 §4.4.4 eq (false)", "input": "<math><apply><eq/><cn>2</cn><cn>3</cn></apply></math>", "expectedValue": "false" },
    { "name": "eq-chained", "spec": "MathML3 §4.4.4 eq (n-ary chained)", "input": "<math><apply><eq/><cn>2</cn><cn>2</cn><cn>2</cn></apply></math>", "expectedValue": "true" },
    { "name": "neq-true", "spec": "MathML3 §4.4.4 neq (relation1.neq)", "input": "<math><apply><neq/><cn>2</cn><cn>3</cn></apply></math>", "expectedValue": "true" },
    { "name": "lt-true", "spec": "MathML3 §4.4.4 lt (relation1.lt)", "input": "<math><apply><lt/><cn>2</cn><cn>3</cn></apply></math>", "expectedValue": "true" },
    { "name": "gt-true", "spec": "MathML3 §4.4.4 gt (relation1.gt)", "input": "<math><apply><gt/><cn>5</cn><cn>2</cn></apply></math>", "expectedValue": "true" },
    { "name": "leq-true", "spec": "MathML3 §4.4.4 leq (relation1.leq)", "input": "<math><apply><leq/><cn>3</cn><cn>3</cn></apply></math>", "expectedValue": "true" },
    { "name": "geq-false", "spec": "MathML3 §4.4.4 geq (false)", "input": "<math><apply><geq/><cn>2</cn><cn>3</cn></apply></math>", "expectedValue": "false" },
    { "name": "lt-rationals", "spec": "MathML3 §4.4.4 lt over rationals (1/3 < 1/2)", "input": "<math><apply><lt/><cn type=\"rational\">1<sep/>3</cn><cn type=\"rational\">1<sep/>2</cn></apply></math>", "expectedValue": "true" },

    { "name": "nested-sum-times", "spec": "MathML3 §4.3.2 nested apply ((2+3)*4)", "input": "<math><apply><times/><apply><plus/><cn>2</cn><cn>3</cn></apply><cn>4</cn></apply></math>", "expectedValue": "20" },
    { "name": "nested-two-sums", "spec": "MathML3 §4.3.2 nested apply ((1+2)*(3+4))", "input": "<math><apply><times/><apply><plus/><cn>1</cn><cn>2</cn></apply><apply><plus/><cn>3</cn><cn>4</cn></apply></apply></math>", "expectedValue": "21" },
    { "name": "nested-quadratic", "spec": "MathML3 §4.3.2 nested apply (x^2 + 2x + 1, x=3)", "input": "<math><apply><plus/><apply><power/><ci>x</ci><cn>2</cn></apply><apply><times/><cn>2</cn><ci>x</ci></apply><cn>1</cn></apply></math>", "expectedValue": "16", "env": { "x": "3" } },

    { "name": "unsupported-sin", "spec": "MathML3 §4.4.3 sin (transcendental => not exactly evaluable)", "input": "<math><apply><sin/><cn>0</cn></apply></math>", "expectedValue": "undef" },
    { "name": "unsupported-exp", "spec": "MathML3 §4.4.3 exp (transcendental => not exactly evaluable)", "input": "<math><apply><exp/><cn>1</cn></apply></math>", "expectedValue": "undef" },
    { "name": "unsupported-ln", "spec": "MathML3 §4.4.3 ln (transcendental => not exactly evaluable)", "input": "<math><apply><ln/><cn>1</cn></apply></math>", "expectedValue": "undef" }
  ]
}
