{
  "provenance": "REC-cited Content MathML linear-algebra evaluation corpus. Each test is derived from a worked <apply> / <matrix> / <vector> construction in the MathML 3.0 (2nd Ed.) Recommendation, Chapter 4 (Content Markup), section 4.4.10 (Linear Algebra), and the OpenMath linalg1 / linalg2 Content Dictionaries it references (matrix, determinant, transpose, scalarproduct, vectorproduct, outerproduct, matrix_selector). Expected values are standard textbook results computed by hand over exact rationals; results are canonicalised by MathML.Content/Math.Matrix (scalar as `n`/`num/den`/`true`/`false`/`undef`, a vector as `[a,b,c]`, a matrix as `[[a,b],[c,d]]`). No public machine-checkable Content-MathML numeric-evaluation suite exists (the W3C/browser MathML test suites are Presentation/rendering tests); this corpus follows the project's endorsed spec-cited pattern. See README.md.",
  "spec": "https://www.w3.org/TR/MathML3/ (chapter 4, section 4.4.10 Linear Algebra)",
  "tests": [
    { "name": "matrix-literal-2x2", "spec": "MathML3 §4.4.10.2 matrix / matrixrow", "input": "<math><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow><matrixrow><cn>3</cn><cn>4</cn></matrixrow></matrix></math>", "expectedValue": "[[1,2],[3,4]]" },
    { "name": "matrix-literal-rational", "spec": "MathML3 §4.4.10.2 matrix over exact rationals", "input": "<math><matrix><matrixrow><cn type=\"rational\">1<sep/>2</cn><cn>0</cn></matrixrow><matrixrow><cn>0</cn><cn type=\"rational\">1<sep/>3</cn></matrixrow></matrix></math>", "expectedValue": "[[1/2,0],[0,1/3]]" },
    { "name": "vector-literal", "spec": "MathML3 §4.4.10.1 vector", "input": "<math><vector><cn>1</cn><cn>2</cn><cn>3</cn></vector></math>", "expectedValue": "[1,2,3]" },

    { "name": "matrix-plus", "spec": "MathML3 §4.4.10 plus over matrices (elementwise)", "input": "<math><apply><plus/><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow><matrixrow><cn>3</cn><cn>4</cn></matrixrow></matrix><matrix><matrixrow><cn>5</cn><cn>6</cn></matrixrow><matrixrow><cn>7</cn><cn>8</cn></matrixrow></matrix></apply></math>", "expectedValue": "[[6,8],[10,12]]" },
    { "name": "matrix-minus", "spec": "MathML3 §4.4.10 minus over matrices (elementwise)", "input": "<math><apply><minus/><matrix><matrixrow><cn>5</cn><cn>6</cn></matrixrow><matrixrow><cn>7</cn><cn>8</cn></matrixrow></matrix><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow><matrixrow><cn>3</cn><cn>4</cn></matrixrow></matrix></apply></math>", "expectedValue": "[[4,4],[4,4]]" },
    { "name": "matrix-plus-shape-mismatch", "spec": "MathML3 §4.4.10 plus over incompatible shapes => undefined", "input": "<math><apply><plus/><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow></matrix><matrix><matrixrow><cn>1</cn><cn>2</cn><cn>3</cn></matrixrow></matrix></apply></math>", "expectedValue": "undef" },

    { "name": "scalar-times-matrix", "spec": "MathML3 §4.4.10 times (scalar * matrix)", "input": "<math><apply><times/><cn>3</cn><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow><matrixrow><cn>3</cn><cn>4</cn></matrixrow></matrix></apply></math>", "expectedValue": "[[3,6],[9,12]]" },
    { "name": "matrix-times-2x2", "spec": "MathML3 §4.4.10.3 times (2x2 . 2x2 product)", "input": "<math><apply><times/><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow><matrixrow><cn>3</cn><cn>4</cn></matrixrow></matrix><matrix><matrixrow><cn>5</cn><cn>6</cn></matrixrow><matrixrow><cn>7</cn><cn>8</cn></matrixrow></matrix></apply></math>", "expectedValue": "[[19,22],[43,50]]" },
    { "name": "matrix-times-rectangular", "spec": "MathML3 §4.4.10.3 times (2x3 . 3x2 => 2x2)", "input": "<math><apply><times/><matrix><matrixrow><cn>1</cn><cn>2</cn><cn>3</cn></matrixrow><matrixrow><cn>4</cn><cn>5</cn><cn>6</cn></matrixrow></matrix><matrix><matrixrow><cn>7</cn><cn>8</cn></matrixrow><matrixrow><cn>9</cn><cn>10</cn></matrixrow><matrixrow><cn>11</cn><cn>12</cn></matrixrow></matrix></apply></math>", "expectedValue": "[[58,64],[139,154]]" },
    { "name": "matrix-times-inner-mismatch", "spec": "MathML3 §4.4.10.3 times (inner dimensions disagree => undefined)", "input": "<math><apply><times/><matrix><matrixrow><cn>1</cn><cn>2</cn><cn>3</cn></matrixrow><matrixrow><cn>4</cn><cn>5</cn><cn>6</cn></matrixrow></matrix><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow><matrixrow><cn>3</cn><cn>4</cn></matrixrow></matrix></apply></math>", "expectedValue": "undef" },

    { "name": "transpose-2x3", "spec": "MathML3 §4.4.10.5 transpose (2x3 => 3x2)", "input": "<math><apply><transpose/><matrix><matrixrow><cn>1</cn><cn>2</cn><cn>3</cn></matrixrow><matrixrow><cn>4</cn><cn>5</cn><cn>6</cn></matrixrow></matrix></apply></math>", "expectedValue": "[[1,4],[2,5],[3,6]]" },
    { "name": "transpose-square", "spec": "MathML3 §4.4.10.5 transpose (2x2)", "input": "<math><apply><transpose/><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow><matrixrow><cn>3</cn><cn>4</cn></matrixrow></matrix></apply></math>", "expectedValue": "[[1,3],[2,4]]" },

    { "name": "determinant-2x2", "spec": "MathML3 §4.4.10.4 determinant (2x2)", "input": "<math><apply><determinant/><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow><matrixrow><cn>3</cn><cn>4</cn></matrixrow></matrix></apply></math>", "expectedValue": "-2" },
    { "name": "determinant-3x3", "spec": "MathML3 §4.4.10.4 determinant (3x3, Laplace expansion)", "input": "<math><apply><determinant/><matrix><matrixrow><cn>6</cn><cn>1</cn><cn>1</cn></matrixrow><matrixrow><cn>4</cn><cn>-2</cn><cn>5</cn></matrixrow><matrixrow><cn>2</cn><cn>8</cn><cn>7</cn></matrixrow></matrix></apply></math>", "expectedValue": "-306" },
    { "name": "determinant-identity-3x3", "spec": "MathML3 §4.4.10.4 determinant (identity => 1)", "input": "<math><apply><determinant/><matrix><matrixrow><cn>1</cn><cn>0</cn><cn>0</cn></matrixrow><matrixrow><cn>0</cn><cn>1</cn><cn>0</cn></matrixrow><matrixrow><cn>0</cn><cn>0</cn><cn>1</cn></matrixrow></matrix></apply></math>", "expectedValue": "1" },
    { "name": "determinant-nonsquare", "spec": "MathML3 §4.4.10.4 determinant (non-square => undefined)", "input": "<math><apply><determinant/><matrix><matrixrow><cn>1</cn><cn>2</cn><cn>3</cn></matrixrow><matrixrow><cn>4</cn><cn>5</cn><cn>6</cn></matrixrow></matrix></apply></math>", "expectedValue": "undef" },

    { "name": "scalarproduct", "spec": "MathML3 §4.4.10 scalarproduct (linalg1) dot product", "input": "<math><apply><scalarproduct/><vector><cn>1</cn><cn>2</cn><cn>3</cn></vector><vector><cn>4</cn><cn>5</cn><cn>6</cn></vector></apply></math>", "expectedValue": "32" },
    { "name": "scalarproduct-mismatch", "spec": "MathML3 §4.4.10 scalarproduct (length mismatch => undefined)", "input": "<math><apply><scalarproduct/><vector><cn>1</cn><cn>2</cn></vector><vector><cn>4</cn><cn>5</cn><cn>6</cn></vector></apply></math>", "expectedValue": "undef" },
    { "name": "vectorproduct", "spec": "MathML3 §4.4.10 vectorproduct (linalg1) cross product (e1 x e2 = e3)", "input": "<math><apply><vectorproduct/><vector><cn>1</cn><cn>0</cn><cn>0</cn></vector><vector><cn>0</cn><cn>1</cn><cn>0</cn></vector></apply></math>", "expectedValue": "[0,0,1]" },
    { "name": "vectorproduct-general", "spec": "MathML3 §4.4.10 vectorproduct (general 3-vectors)", "input": "<math><apply><vectorproduct/><vector><cn>2</cn><cn>3</cn><cn>4</cn></vector><vector><cn>5</cn><cn>6</cn><cn>7</cn></vector></apply></math>", "expectedValue": "[-3,6,-3]" },
    { "name": "outerproduct", "spec": "MathML3 §4.4.10 outerproduct (linalg1) u (x) v", "input": "<math><apply><outerproduct/><vector><cn>1</cn><cn>2</cn></vector><vector><cn>3</cn><cn>4</cn></vector></apply></math>", "expectedValue": "[[3,4],[6,8]]" },

    { "name": "selector-matrix", "spec": "MathML3 §4.4.10 selector (1-based (i,j) element of a matrix)", "input": "<math><apply><selector/><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow><matrixrow><cn>3</cn><cn>4</cn></matrixrow></matrix><cn>2</cn><cn>1</cn></apply></math>", "expectedValue": "3" },
    { "name": "selector-vector", "spec": "MathML3 §4.4.10 selector (1-based i-th element of a vector)", "input": "<math><apply><selector/><vector><cn>10</cn><cn>20</cn><cn>30</cn></vector><cn>2</cn></apply></math>", "expectedValue": "20" },
    { "name": "selector-out-of-range", "spec": "MathML3 §4.4.10 selector (index out of range => undefined)", "input": "<math><apply><selector/><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow></matrix><cn>3</cn><cn>1</cn></apply></math>", "expectedValue": "undef" },

    { "name": "matrix-times-then-determinant", "spec": "MathML3 §4.3.2 nested apply (det(A.B) = det A . det B)", "input": "<math><apply><determinant/><apply><times/><matrix><matrixrow><cn>1</cn><cn>2</cn></matrixrow><matrixrow><cn>3</cn><cn>4</cn></matrixrow></matrix><matrix><matrixrow><cn>2</cn><cn>0</cn></matrixrow><matrixrow><cn>1</cn><cn>2</cn></matrixrow></matrix></apply></apply></math>", "expectedValue": "-8" }
  ]
}
